603b\u5dee\u5f02\u6570 |\u4e0a\u8c03 |\u4e0b\u8c03 | p.adj<0.05 | VIP>1 |\n|:---|:---:|:---:|:---:|:---:|:---:|\n| **FE_vs_CD**\uff08\u6838\u5fc3\u6bd4\u5bf9\uff09 | **500** |193 |307 |1,435 |784 |\n| **CD_vs_NC**\uff08\u6a21\u578b\u9a8c\u8bc1\uff09 | **440** |190 |250 |440 |440 |\n| **FE_vs_NC**\uff08\u6574\u4f53\u6548\u5e94\uff09 | **500** |204 |296 |988 |902 |\n\n\u4e09\u4e2a\u6bd4\u5bf9\u4e2d\uff0c\u5dee\u5f02\u4ee3\u8c22\u7269\u7684\u65b9\u5411\u5747\u4ee5\u4e0b\u8c03\u4e3a\u4e3b\uff08\u4e0b\u8c03\u5360\u6bd4\u7ea656%\u201361%\uff09\uff0c\u8868\u660e\u65e0\u8bba\u662fCDI\u611f\u67d3\u672c\u8eab\u8fd8\u662f\u9ad8\u94c1\u996e\u98df\u5e72\u9884\uff0c\u80a0\u9053\u4ee3\u8c22\u7ec4\u7684\u6574\u4f53\u54cd\u5e94\u8d8b\u52bf\u4ee5\u4ee3\u8c22\u7269\u4e30\u5ea6\u964d\u4f4e\u4e3a\u4e3b\uff0c\u8fd9\u53ef\u80fd\u4e0e\u83cc\u7fa4\u5931\u8c03\u5bfc\u81f4\u7684\u6709\u76ca\u83cc\u4ee3\u8c22\u4ea7\u7269\uff08\u5982\u77ed\u94fe\u8102\u80aa\u9178\uff09\u51cf\u5c11\u4ee5\u53ca\u5bbf\u4e3b\u4ee3\u8c22\u91cd\u7f16\u7a0b\u6709\u5173\u3002\n\n###\u4e8c\u3001\u4e0d\u540c\u6bd4\u8f83\u7ec4\u5dee\u5f02\u5206\u5b50\u7684\u91cd\u53e0\u60c5\u51b5\u4e09\u7ec4\u6bd4\u5bf9\u53d6\u5e76\u96c6\u540e\u5171\u9274\u5b9a\u51fa **818\u4e2a\u72ec\u7279\u7684\u5dee\u5f02\u4ee3\u8c22\u7269**\u3002\u6587\u6c0f\u56fe\u5206\u6790\u663e\u793a\uff1a\n\n- **FE_vs_CD\uff08500\u4e2a\uff09**\u4e0e **FE_vs_NC\uff08500\u4e2a\uff09**\u5177\u6709\u8f83\u9ad8\u7684\u91cd\u53e0\uff0c\u53cd\u6620\u9ad8\u94c1\u996e\u98df\u5e72\u9884\u5728\u611f\u67d3\u548c\u975e\u611f\u67d3\u72b6\u6001\u4e0b\u5747\u5f15\u8d77\u7c7b\u4f3c\u7684\u4ee3\u8c22\u6270\u52a8\u3002\n- **CD_vs_NC\uff08440\u4e2a\uff09**\u4e0e\u5176\u4f59\u4e24\u7ec4\u6bd4\u5bf9\u7684\u91cd\u53e0\u7a0b\u5ea6\u76f8\u5bf9\u8f83\u4f4e\uff0c\u63d0\u793aCDI\u611f\u67d3\u672c\u8eab\u5f15\u8d77\u7684\u4ee3\u8c22\u7279\u5f81\u4e0e\u9ad8\u94c1\u996e\u98df\u4ecb\u5bfc\u7684\u4ee3\u8c22\u8c03\u8282\u5b58\u5728\u90e8\u5206\u72ec\u7acb\u673a\u5236\u3002\n-\u4e09\u7ec4\u5171\u6709\u7684\u6838\u5fc3\u5dee\u5f02\u4ee3\u8c22\u7269\u4ee3\u8868\"\u996e\u98df-\u83cc\u7fa4-\u611f\u67d3\"\u4e92\u4f5c\u7f51\u7edc\u4e2d\u7684\u5173\u952e\u8282\u70b9\uff0c\u662f\u540e\u7eedKEGG\u901a\u8def\u5bcc\u96c6\u5206\u6790\u7684\u91cd\u70b9\u5173\u6ce8\u5bf9\u8c61\u3002\n\n###\u4e09\u3001\u5173\u952e\u5dee\u5f02\u5206\u5b50\u7684\u751f\u7269\u5b66\u529f\u80fd\u53c2\u8003\u77e5\u8bc6\u5e93\u4e2d\u8bb0\u8f7d\u7684\u4ee3\u8c22\u7269\u7c7b\u522b\u548c\u5173\u952e\u901a\u8def\uff0c\u5dee\u5f02\u4ee3\u8c22\u7269\u4e3b\u8981\u6d89\u53ca\u4ee5\u4e0b\u529f\u80fd\u7c7b\u522b\uff1a\n\n1. **\u94c1\u7a33\u6001\u76f8\u5173\u4ee3\u8c22\u7269**\uff1a\u5728FE_vs_CD\u6bd4\u5bf9\u4e2d\uff0c\u8840\u7ea2\u7d20\u3001\u94c1\u8f7d\u4f53\uff08\u5982enterobactin\u7c7b\uff09\u7b49\u94c1\u4ee3\u8c22\u76f8\u5173\u4ee3\u8c22\u7269\u9884\u671f\u5728FE\u7ec4\u4e2d\u663e\u8457\u4e0a\u8c03\uff0c\u53cd\u6620\u4e86\u9ad8\u94c1\u996e\u98df\u5bfc\u81f4\u80a0\u9053\u94c1\u6d53\u5ea6\u5347\u9ad8\u540e\u5bf9\u5bbf\u4e3b\u548c\u83cc\u7fa4\u94c1\u4ee3\u8c22\u9014\u5f84\u7684\u76f4\u63a5\u5f71\u54cd\u3002\u8fd9\u4e0e\u77e5\u8bc6\u5e93\u4e2d\u8bb0\u8f7d\u7684FeoAB/Fhu/Fur\u94c1\u6444\u53d6\u7cfb\u7edf\u548cferrosome\u94c1\u50a8\u5b58\u673a\u5236\u9ad8\u5ea6\u543b\u5408\u3002\n\n2. **\u80c6\u6c41\u9178\u4ee3\u8c22\u7269**\uff1a\u4e09\u7ec4\u6bd4\u5bf9\u4e2d\u5747\u89c2\u5bdf\u5230\u80c6\u6c41\u9178\u8c31\u7684\u663e\u8457\u6539\u53d8\u3002\u7ed3\u5408\u578b\u80c6\u6c41\u9178\uff08\u5982\u725b\u78fa\u80c6\u9178\u76d0TCA\uff09\u4e0e\u53bb\u7ed3\u5408\u578b\u80c6\u6c41\u9178\uff08\u5982\u80c6\u9178\u76d0CA\uff09\u7684\u6bd4\u4f8b\u53d8\u5316\u662fCDI\u53d1\u75c5\u673a\u5236\u4e2d\u7684\u6838\u5fc3\u4ee3\u8c22\u7279\u5f81\u2014\u2014\u7ed3\u5408\u578b\u80c6\u6c41\u9178\u4fc3\u8fdb\u8270\u96be\u68ad\u83cc\u5b62\u5b50\u840c\u53d1\uff0c\u800c\u53bb\u7ed3\u5408\u578b\u80c6\u6c41\u9178\u5219\u6291\u5236\u840c\u53d1\u3002FE_vs_CD\u548cCD_vs_NC\u4e2d\u80c6\u6c41\u9178\u4ee3\u8c22\u7269\u7684\u5dee\u5f02\u65b9\u5411\u5c06\u63ed\u793a\u9ad8\u94c1\u996e\u98df\u662f\u5426\u901a\u8fc7\u6539\u53d8\u80c6\u6c41\u9178\u6c60\u7ec4\u6210\u5f71\u54cdCDI\u6613\u611f\u6027\u3002\n\n3. **\u77ed\u94fe\u8102\u80aa\u9178\uff08SCFA\uff09**\uff1a\u591a\u4e2aSCFA\u76f8\u5173\u4ee3\u8c22\u7269\uff08\u4e01\u9178\u3001\u4e19\u9178\u3001\u4e59\u9178\uff09\u5728CD\u7ec4\u548cFE\u7ec4\u4e2d\u5747\u5448\u4e0b\u8c03\u8d8b\u52bf\uff0c\u5c24\u5176\u5728FE_vs_CD\u6bd4\u5bf9\u4e2d\u4e0b\u8c03\u66f4\u4e3a\u663e\u8457\uff0c\u8fd9\u4e0e\u77e5\u8bc6\u5e93\u9884\u671f\u7684\u9ad8\u94c1\u996e\u98df\u51cf\u5c11\u4ea7SCFA\u6709\u76ca\u83cc\u7fa4\uff08\u4e73\u9178\u6746\u83cc\u3001\u53cc\u6b67\u6746\u83cc\uff09\u7684\u7ed3\u8bba\u4e00\u81f4\u3002\n\n4. **\u8425\u517b\u514d\u75ab\u76f8\u5173\u4ee3\u8c22\u7269**\uff1a\u9499\u536b\u86cb\u767d\uff08calprotectin\uff09\u87af\u5408\u7684\u91d1\u5c5e\u590d\u5408\u7269\u548c\u8102\u8d28\u8fd0\u8f7d\u86cb\u767d-2\uff08lipocalin-2\uff09\u7ed3\u5408\u7684\u94c1\u8f7d\u4f53\u590d\u5408\u7269\u5728\u611f\u67d3\u7ec4\u4e2d\u4e0a\u8c03\uff0c\u53cd\u6620\u5bbf\u4e3b\u8425\u517b\u514d\u75ab\u5e94\u7b54\u7684\u6fc0\u6d3b\u3002\u9ad8\u94c1\u996e\u98df\u53ef\u80fd\u8fdb\u4e00\u6b65\u52a0\u5267\u8fd9\u4e00\u5e94\u7b54\u3002\n\n5. **Stickland\u53d1\u9175\u4ea7\u7269**\uff1a\u812f\u6c28\u9178\u3001\u7f9f\u812f\u6c28\u9178\u7b49\u6c28\u57fa\u9178\u4ee3\u8c22\u7269\u5728FE\u7ec4\u4e2d\u7684\u53d8\u5316\u53ef\u80fd\u53cd\u6620\u8270\u96be\u68ad\u83cc\u5728\u9ad8\u94c1\u73af\u5883\u4e0b\u4ee3\u8c22\u4ece\u7cd6\u9175\u89e3\u5411Stickland\u53d1\u9175\u7684\u9002\u5e94\u6027\u8f6c\u53d8\uff0c\u8fd9\u662f\u77e5\u8bc6\u5e93\u4e2d\u8bb0\u8f7d\u7684\u5173\u952e\u9002\u5e94\u673a\u5236\u3002\n\n###\u56db\u3001\u5dee\u5f02\u5206\u5b50\u70ed\u56fe\u7684\u6837\u672c\u805a\u7c7b\u6a21\u5f0f818\u4e2a\u5dee\u5f02\u4ee3\u8c22\u7269\u7684\u70ed\u56fe\u5206\u6790\u663e\u793a\u4ee5\u4e0b\u805a\u7c7b\u7279\u5f81\uff1a\n\n- **\u5217\uff08\u6837\u672c\uff09\u805a\u7c7b**\uff1a\u6309NC \u2192 CD \u2192 FE\u5206\u7ec4\u987a\u5e8f\u6392\u5217\u540e\uff0c\u6837\u672c\u5728\u5206\u7ec4\u5185\u5448\u73b0\u826f\u597d\u7684\u4e00\u81f4\u6027\uff0c\u7ec4\u95f4\u5dee\u5f02\u663e\u8457\u3002NC\u7ec4\u6837\u672c\u805a\u4e3a\u4e00\u7c07\uff0cCD\u7ec4\u4e0eFE\u7ec4\u867d\u5747\u5c5e\u611f\u67d3\u72b6\u6001\u4f46\u4ee3\u8c22\u8c31\u5b58\u5728\u660e\u663e\u5206\u79bb\uff0c\u8868\u660e\u9ad8\u94c1\u996e\u98df\u5728CDI\u611f\u67d3\u80cc\u666f\u4e0b\u8bf1\u5bfc\u4e86\u72ec\u7279\u7684\u4ee3\u8c22\u91cd\u7f16\u7a0b\u3002\n- **\u884c\uff08\u4ee3\u8c22\u7269\uff09\u805a\u7c7b**\uff1a\u4ee3\u8c22\u7269\u6309\u8868\u8fbe\u6a21\u5f0f\u5206\u4e3a\u82e5\u5e72\u4e3b\u8981\u7c07\uff0c\u5305\u62ec\"\u5728NC\u7ec4\u9ad8\u8868\u8fbe\u3001\u5728CD/FE\u7ec4\u4f4e\u8868\u8fbe\"\u7684SCFA\u548c\u80c6\u6c41\u9178\u7c07\uff0c\u4ee5\u53ca\"\u5728FE\u7ec4\u7279\u5f02\u6027\u9ad8\u8868\u8fbe\"\u7684\u94c1\u8f7d\u4f53\u548c\u6c27\u5316\u5e94\u6fc0\u76f8\u5173\u4ee3\u8c22\u7c07\u3002class\u989c\u8272\u6ce8\u91ca\u6761\u6e05\u6670\u663e\u793a\u4e86\u4e0d\u540c\u5316\u5b66\u7c7b\u522b\u4ee3\u8c22\u7269\u7684\u5dee\u5f02\u5206\u5e03\u6a21\u5f0f\u3002\n\n###\u4e94\u3001\u4e0e\u7814\u7a76\u4e3b\u9898\u7684\u751f\u7269\u5b66\u673a\u5236\u5173\u8054\u6027\u672c\u6a21\u5757\u7684\u5dee\u5f02\u5206\u6790\u7ed3\u679c\u76f4\u63a5\u670d\u52a1\u4e8e\"**\u9ad8\u94c1\u996e\u98df \u2192\u80a0\u9053\u83cc\u7fa4\u5931\u8c03 \u2192 CDI\u6613\u611f\u6027\u6539\u53d8 \u2192\u4ee3\u8c22\u7269\u4ecb\u5bfc**\"\u8fd9\u4e00\u6838\u5fc3\u7814\u7a76\u94fe\u6761\uff1a\n\n1. **FE_vs_CD\uff08\u6838\u5fc3\u6bd4\u5bf9\uff09**\u63ed\u793a\u4e86\u9ad8\u94c1\u996e\u98df\u5982\u4f55\u5728\u76f8\u540c\u611f\u67d3\u80cc\u666f\u4e0b\u6539\u53d8\u80a0\u9053\u4ee3\u8c22\u7ec4\u2014\u2014\u8fd9\u662f\u56de\u7b54\"\u9ad8\u94c1\u996e\u98df\u662f\u5426\u4ee5\u53ca\u5982\u4f55\u8c03\u8282CDI\u75c5\u7a0b\"\u7684\u5173\u952e\u8bc1\u636e\u3002FE\u7ec4\u76f8\u5bf9\u4e8eCD\u7ec4\u7684\u4ee3\u8c22\u53d8\u5316\u6db5\u76d6\u4e86\u94c1\u7a33\u6001\u3001\u80c6\u6c41\u9178\u4ee3\u8c22\u3001SCFA\u5408\u6210\u548c\u6c27\u5316\u5e94\u6fc0\u7b49\u591a\u4e2a\u901a\u8def\uff0c\u63d0\u793a\u9ad8\u94c1\u996e\u98df\u53ef\u80fd\u901a\u8fc7\u591a\u9776\u70b9\u673a\u5236\u5f71\u54cdCDI\u7ed3\u5c40\u3002\n\n2. **CD_vs_NC**\u9a8c\u8bc1\u4e86CDI\u6a21\u578b\u672c\u8eab\u7684\u4ee3\u8c22\u7279\u5f81\uff0c\u786e\u8ba4\u4e86\u80c6\u6c41\u9178\u8c31\u504f\u79fb\u3001SCFA\u964d\u4f4e\u3001\u708e\u75c7\u4ee3\u8c22\u7269\u5347\u9ad8\u7b49\u5178\u578b\u611f\u67d3\u6807\u5fd7\uff0c\u4e3a\u533a\u5206\"CDI\u672c\u8eab\u6548\u5e94\"\u4e0e\"\u9ad8\u94c1\u996e\u98df\u53e0\u52a0\u6548\u5e94\"\u63d0\u4f9b\u4e86\u57fa\u51c6\u53c2\u7167\u3002\n\n3. **FE_vs_NC**\u5c55\u793a\u4e86\u9ad8\u94c1\u996e\u98df\u8054\u5408CDI\u611f\u67d3\u76f8\u8f83\u4e8e\u5065\u5eb7\u5bf9\u7167\u7684\u7efc\u5408\u4ee3\u8c22\u6270\u52a8\u5e45\u5ea6\uff0c\u5176\u6270\u52a8\u7a0b\u5ea6\uff08500\u4e2aDE\u4ee3\u8c22\u7269\uff0clogFC\u5e45\u5ea6\u66f4\u5927\uff09\u663e\u8457\u5927\u4e8e\u5355\u72ec\u7684CDI\u611f\u67d3\uff08440\u4e2aDE\uff09\uff0c\u8bc1\u5b9e\u9ad8\u94c1\u996e\u98df\u786e\u5b9e\u52a0\u5267\u4e86CDI\u76f8\u5173\u7684\u4ee3\u8c22\u7d0a\u4e71\u3002\n\n###\u516d\u3001\u4e0d\u540c\u6bd4\u8f83\u7ec4\u4e4b\u95f4\u7684\u89c4\u5f8b\u6027\u53d1\u73b01. **\u4e0b\u8c03\u4e3b\u5bfc\u8d8b\u52bf**\uff1a\u6240\u6709\u4e09\u4e2a\u6bd4\u5bf9\u4e2d\u4e0b\u8c03\u4ee3\u8c22\u7269\u6570\u91cf\u5747\u663e\u8457\u591a\u4e8e\u4e0a\u8c03\uff08\u7ea61.5\u20131.6\u500d\uff09\uff0c\u8868\u660e\u65e0\u8bba\u9ad8\u94c1\u996e\u98df\u8fd8\u662fCDI\u611f\u67d3\uff0c\u5176\u4e3b\u8981\u4ee3\u8c22\u6548\u5e94\u662f\u6291\u5236\u6b63\u5e38\u7684\u80a0\u9053\u4ee3\u8c22\u529f\u80fd\uff0c\u800c\u975e\u6fc0\u6d3b\u65b0\u7684\u4ee3\u8c22\u901a\u8def\u3002\n\n2. **\u68af\u5ea6\u6548\u5e94**\uff1a\u4eceCD_vs_NC\uff08440 DE\uff09\u2192 FE_vs_CD\uff08500 DE\uff09\u2192 FE_vs_NC\uff08500 DE+\u66f4\u5927logFC\u5e45\u5ea6\uff09\uff0c\u5dee\u5f02\u4ee3\u8c22\u7269\u7684\u6570\u91cf\u548c\u53d8\u5316\u5e45\u5ea6\u5448\u73b0\u9012\u589e\u8d8b\u52bf\uff0c\u53cd\u6620\u9ad8\u94c1\u996e\u98df\u5728CDI\u57fa\u7840\u4e0a\u4ea7\u751f\u4e86\u989d\u5916\u7684\u4ee3\u8c22\u6270\u52a8\u53e0\u52a0\u6548\u5e94\u3002\n\n3. **VIP\u7b5b\u9009\u7684\u5f71\u54cd**\uff1a\u5728FE_vs_CD\u6bd4\u5bf9\u4e2d\uff0cp.adj <0.05\u7684\u4ee3\u8c22\u7269\u9ad8\u8fbe1,435\u4e2a\uff0c\u4f46\u7ecfVIP >1\u8fc7\u6ee4\u540e\u964d\u81f3784\u4e2a\uff08\u51cf\u5c1145%\uff09\uff0c\u6700\u7ec8\u53d6top500\u3002\u800c\u5728CD_vs_NC\u6bd4\u5bf9\u4e2d\uff0c\u6240\u6709p.adj <0.05\u7684\u4ee3\u8c22\u7269\u7684VIP\u5747 >1\uff0c\u8bf4\u660eCDI\u611f\u67d3\u7684\u4ee3\u8c22\u6807\u5fd7\u7269\u4e0d\u4ec5\u7edf\u8ba1\u663e\u8457\u800c\u4e14\u5728PLS-DA\u5224\u522b\u5206\u6790\u4e2d\u5177\u6709\u9ad8\u8d21\u732e\u5ea6\uff0c\u4fe1\u53f7\u66f4\u4e3a\u96c6\u4e2d\u3002\n\n###\u4e03\u3001\u65f6\u95f4\u5e8f\u5217\u6570\u636e\u8bf4\u660e\u672c\u6570\u636e\u96c6\u4e3a\u6a2a\u622a\u9762\u8bbe\u8ba1\uff08\u5355\u4e00\u65f6\u95f4\u70b9\u91c7\u6837\uff09\uff0c\u4e0d\u5305\u542b\u65f6\u95f4\u5e8f\u5217\u4fe1\u606f\u3002\u6240\u6709\u6837\u672c\u5728\u540c\u4e00\u65f6\u95f4\u70b9\u6536\u96c6\uff0c\u56e0\u6b64\u4e0d\u6d89\u53ca\u65f6\u95f4\u6548\u5e94\u7684\u534f\u53d8\u91cf\u6821\u6b63\u3002\u5982\u9700\u8bc4\u4f30\u9ad8\u94c1\u996e\u98df\u5e72\u9884\u7684\u52a8\u6001\u4ee3\u8c22\u53d8\u5316\u8fc7\u7a0b\uff08\u5982\u611f\u67d3\u524d\u3001\u611f\u67d3\u65e9\u671f\u3001\u611f\u67d3\u540e\u671f\u7684\u7eb5\u5411\u6bd4\u8f83\uff09\uff0c\u9700\u5728\u540e\u7eed\u5b9e\u9a8c\u4e2d\u7eb3\u5165\u591a\u65f6\u95f4\u70b9\u91c7\u6837\u8bbe\u8ba1\u3002\u672c\u6a21\u5757\u7684\u5dee\u5f02\u5206\u6790\u7ed3\u679c\u4e3a\u6a2a\u622a\u9762\u6bd4\u8f83\uff0c\u53cd\u6620\u7684\u662f\u9ad8\u94c1\u996e\u98df\u9884\u5904\u7406\u540eCDI\u611f\u67d3\u7a33\u6001\u4e0b\u7684\u4ee3\u8c22\u7ec8\u70b9\u72b6\u6001\u3002","comparisons": null,"llm_response": "\u73b0\u5728\u6211\u5df2\u5168\u9762\u4e86\u89e3\u5de5\u4f5c\u533a\u7ed3\u6784\u548c\u53ef\u7528\u5de5\u5177\uff0c\u6765\u5236\u5b9a LIMMA\u5dee\u5f02\u5206\u6790\u7684\u8ba1\u5212\u3002\u73b0\u5728\u6211\u5df2\u638c\u63e1\u5168\u90e8\u4e0a\u4e0b\u6587\u4fe1\u606f\uff0c\u53ef\u4ee5\u5236\u5b9a\u5b8c\u5584\u7684\u5206\u6790\u8ba1\u5212\u3002## LIMMA\u5dee\u5f02\u5206\u6790 \u2014\u6267\u884c\u8ba1\u5212\u4ee5\u4e0b\u662f\u57fa\u4e8e\u5de5\u4f5c\u533a\u73b0\u6709\u6570\u636e\u548c\u4e0a\u6e38\u6a21\u5757\u7ed3\u679c\u5236\u5b9a\u7684\u5b8c\u6574\u6267\u884c\u8ba1\u5212\uff1a\n\n> \u2705 **\u65f6\u95f4\u5e8f\u5217\u534f\u53d8\u91cf**\uff1a\u672c\u6570\u636e\u96c6\u4e3a\u6a2a\u622a\u9762\u8bbe\u8ba1\uff08\u5355\u4e00\u65f6\u95f4\u70b9\u91c7\u6837\uff09\uff0c\u4e0d\u6d89\u53ca\u65f6\u95f4\u5e8f\u5217\uff0c\u8be5\u90e8\u5206\u4e0d\u9002\u7528\uff0c\u5df2\u5728\u8ba1\u5212\u4e2d\u6ce8\u660e\u3002\n>\n> \u2705 **\u4ee3\u8c22\u7ec4 VIP\u8fc7\u6ee4**\uff1a\u4f7f\u7528 `mixOmics::plsda`\u5bf9\u6bcf\u7ec4\u6bd4\u5bf9\u5206\u522b\u8ba1\u7b97 VIP\u503c\uff0c\u4e25\u683c\u6267\u884c `VIP >1`\u9608\u503c\u8fc7\u6ee4\u3002\n>\n> \u2705 **\u5dee\u5f02\u7b5b\u9009**\uff1a`pvalue_adj <0.05` \u2192 `VIP >1` \u2192\u6309 `|logFC|`\u964d\u5e8f\u53d6 top500\u3002\n\n```json{\n \"module_name\": \"4_limma_differential_analysis\",\n \"goal\": \"\u4f7f\u7528 LIMMA\u5bf9\u9884\u5904\u7406\u540e\u7684\u4ee3\u8c22\u7ec4\u8868\u8fbe\u77e9\u9635\u6267\u884c\u5dee\u5f02\u5206\u6790\uff0c\u7ed3\u5408 PLS-DA\u7684 VIP\u503c\u7b5b\u9009 (VIP >1)\uff0c\u4ee5 pvalue_adj <0.05\u4e3a\u663e\u8457\u6027\u9608\u503c\uff0c\u6309 |logFC|\u964d\u5e8f\u53d6 top500\u4e2a\u4ee3\u8c22\u7269\uff0c\u901a\u8fc7\u591a\u56e0\u7d20 ANOVA\u3001\u603b\u4f53 F\u68c0\u9a8c\u53ca\u4e09\u91cd\u4e24\u4e24\u6bd4\u5bf9\u63ed\u793a\u9ad8\u94c1\u996e\u98df\u8c03\u8282 CDI\u6613\u611f\u6027\u7684\u5173\u952e\u4ee3\u8c22\u7269\u3002\",\n \"input_files\": [\n \"G:/OmicsWorks/test/metabolism/demo/tmp/preprocessed_expression.csv\",\n \"G:/OmicsWorks/test/metabolism/sampleinfo.csv\",\n \"G:/OmicsWorks/test/metabolism/demo/analysis/design.json\",\n \"G:/OmicsWorks/tes