84c F\u68c0\u9a8c\uff08\u7b49\u4ef7\u4e8e ANOVA\u5168\u5c40\u68c0\u9a8c\uff09\uff0c\u8f93\u51fa F\u7edf\u8ba1\u91cf\u548c\u6821\u6b63 P\u503c\uff0c\u8bc4\u4f30\u6574\u4f53\u7ec4\u95f4\u5dee\u5f02\u663e\u8457\u6027\u3002\n(2c)\u5bf9 design.json\u4e2d\u6bcf\u7ec4\u6bd4\u5bf9\u5206\u522b\u6267\u884c LIMMA\uff1a\u6784\u5efa\u8bbe\u8ba1\u77e9\u9635 (~0 + group)\uff0c\u4f7f\u7528 makeContrasts\u8bbe\u7f6e\u5bf9\u6bd4\uff08\u5982 \"high iron diet before - Clostridium difficile infection\"\uff09\uff0clmFit + contrasts.fit + eBayes\u7ecf\u9a8c\u8d1d\u53f6\u65af\uff0c\u63d0\u53d6 logFC\u3001pvalue\u3001pvalue_adj\uff08BH\uff09\u3002\n(2d) VIP\u503c\u8ba1\u7b97\uff1a\u5bf9\u6bcf\u7ec4\u6bd4\u5bf9\u7684\u4e24\u7ec4\u6837\u672c\u4f7f\u7528 mixOmics::plsda\u8bad\u7ec3\u6a21\u578b\uff08ncomp =2\uff09\uff0c\u63d0\u53d6\u7b2c1\u4e3b\u6210\u5206\u7684 VIP\u503c\u5411\u91cf\uff0c\u5408\u5e76\u5230 LIMMA\u7ed3\u679c\u8868\u3002\n(2e)\u5dee\u5f02\u7b5b\u9009\u6d41\u6c34\u7ebf\uff1a\u7b5b\u9009 pvalue_adj <0.05 \u2192 VIP >1\uff08\u4ee3\u8c22\u7ec4\u7279\u5f02\u6027\uff09\u2192\u6309 |logFC|\u964d\u5e8f\u53d6 top500\uff08\u82e5\u4e0d\u8db3500\u5219\u5168\u53d6\uff09\u3002\u6807\u8bb0\u4e0a\u8c03/\u4e0b\u8c03\u65b9\u5411\uff08logFC >0\u4e3a treatment\u4e0a\u8c03\uff0c<0\u4e3a control\u4e0a\u8c03\uff09\u3002\n(2f)\u5408\u5e76\u4e09\u7ec4\u6bd4\u5bf9\u7ed3\u679c\u5230 consolidated\u603b\u8868\uff08\u5305\u542b\u4ee3\u8c22\u7269 ID\u3001\u5404\u6bd4\u5bf9 logFC\u3001pvalue_adj\u3001VIP\u53ca\u663e\u8457\u6027\u6807\u5fd7\uff09\uff0c\u8f93\u51fa\u5230 tables/\u76ee\u5f55\u3002","goal": "\u5b8c\u6210\u591a\u56e0\u7d20 ANOVA\u3001\u603b\u4f53 F\u68c0\u9a8c\u548c\u4e09\u4e2a\u4e24\u4e24\u6bd4\u5bf9\u7684 LIMMA\u5dee\u5f02\u5206\u6790\uff0c\u6574\u5408 VIP\u503c\u8fdb\u884c\u4ee3\u8c22\u7ec4\u7279\u5f02\u6027\u7b5b\u9009\uff08pvalue_adj <0.05 & VIP >1 & top500 by |logFC|\uff09\uff0c\u8f93\u51fa\u5b8c\u6574\u7684\u5dee\u5f02\u5206\u6790\u7ed3\u679c\u8868\u4f9b\u4e0b\u6e38\u6a21\u5757\u4f7f\u7528\u3002","rscript_path": null},{"action": "Step3:\u51fa\u7248\u7ea7\u53ef\u89c6\u5316\u4e0e\u7ed3\u679c\u8f93\u51fa\u3002\n(3a)\u706b\u5c71\u56fe\uff08\u6bcf\u7ec4\u6bd4\u5bf9\u5404\u4e00\u5f20\uff09\uff1a\u4f7f\u7528 plot_volcano\uff08\u5b9a\u5236\u7248\uff09\uff0cX\u8f74 = logFC\uff0cY\u8f74 = -log10(pvalue_adj)\uff0c\u4e0a\u8c03\uff08logFC >0\uff09\u7528\u7ea2\u8272 (#E64B35)\u3001\u4e0b\u8c03\u7528\u84dd\u8272 (#4DBBD5)\u3001\u4e0d\u663e\u8457\u7528\u7070\u8272\u3002\u6807\u6ce8 Top5\u5dee\u5f02\u4ee3\u8c22\u7269\u540d\u79f0\uff08\u4f18\u5148\u4f7f\u7528 metabolites.csv\u7684 name\u5217\uff0c\u82e5\u65e0\u5219\u7528\u4ee3\u8c22\u7269 ID\uff09\u3002\u6dfb\u52a0 pvalue_adj =0.05\u6c34\u5e73\u865a\u7ebf\u3002\n(3b)\u6587\u6c0f\u56fe\uff1a\u4f7f\u7528 ggVennDiagram\u7ed8\u5236\u4e09\u7ec4\u6bd4\u5bf9\u5dee\u5f02\u4ee3\u8c22\u7269\u96c6\u5408\u7684\u4ea4\u96c6/\u5e76\u96c6\u6587\u6c0f\u56fe\uff08\u6700\u591a\u652f\u63013\u7ec4\uff09\uff0c\u5c55\u793a\u4e09\u8005\u91cd\u53e0\u60c5\u51b5\u3002\n(3c)\u5dee\u5f02\u4ee3\u8c22\u7269\u70ed\u56fe\uff1a\u53d6\u4e09\u7ec4\u6bd4\u5bf9\u5dee\u5f02\u4ee3\u8c22\u7269\u7684\u5e76\u96c6\uff08\u53bb\u91cd\uff09\uff0c\u884c =\u4ee3\u8c22\u7269\uff08\u5c42\u6b21\u805a\u7c7b\uff09\uff0c\u5217 =\u6837\u672c\uff08\u6309 NC \u2192 CD \u2192 FE\u5206\u7ec4\u987a\u5e8f\u6392\u5217\uff0c\u4e0d\u505a\u5217\u805a\u7c7b\uff09\u3002\u4ece metabolites.csv\u63d0\u53d6 class\u6216 category\u5217\u4f5c\u4e3a\u884c\u6ce8\u91ca\u989c\u8272\u5757\u3002\u8868\u8fbe\u503c\u4ee5\u884c Z-score\u6807\u51c6\u5316\u663e\u793a\u3002\u663e\u793a\u4ee3\u8c22\u7269\u540d\u79f0\uff08\u5982\u679c <100\u4e2a\u5dee\u5f02\u7269\uff09\u548c\u6837\u672c\u540d\u79f0\u3002\n(3d)\u6240\u6709\u56fe\u5f62\u540c\u65f6\u4fdd\u5b58\u4e3a PDF\uff08\u77e2\u91cf\uff09\u548c PNG\uff08300 dpi\u4f4d\u56fe\uff09\u4e24\u79cd\u683c\u5f0f\uff0c\u6587\u5b57\u6807\u7b7e\u5168\u90e8\u4f7f\u7528\u82f1\u6587\uff0c\u5e94\u7528 theme_bw\u51fa\u7248\u7ea7\u4e3b\u9898\u3002\n(3e)\u5c06\u5b8c\u6574\u5