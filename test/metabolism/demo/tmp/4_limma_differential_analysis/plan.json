6\u5230 LIMMA\u7ed3\u679c\u8868\u4e2d\u3002\n4.\u3010\u6ce8\u91ca\u8868\u5339\u914d\u3011metabolites.csv\uff082172\u884c\uff09\u9700\u6309\u7b2c\u4e00\u5217 ID\u5339\u914d\u5230\u8868\u8fbe\u77e9\u9635\u884c\u540d\uff082059\u4e2a\u4ee3\u8c22\u7269\uff09\uff0c\u7f3a\u5931\u5339\u914d\u7684\u4ee3\u8c22\u7269\u6807\u8bb0\u4e3a 'Unknown'\u3002\u63d0\u53d6 class\u548c category\u5217\u7528\u4e8e\u70ed\u56fe\u884c\u6ce8\u91ca\u989c\u8272\u5757\uff0cname\u5217\u7528\u4e8e\u706b\u5c71\u56fe\u6807\u7b7e\u3002\n5.\u3010\u5206\u7ec4\u547d\u540d\u3011CD = 'Clostridium difficile infection'\uff08\u8270\u96be\u68ad\u83cc\u611f\u67d3\u7ec4\uff09\uff0cFE = 'high iron diet before'\uff08\u611f\u67d3\u524d\u9ad8\u94c1\u996e\u98df\u5e72\u9884\u7ec4\uff09\uff0cNC = 'Standard (control)'\uff08\u5065\u5eb7\u5bf9\u7167\uff09\u3002\u8fd9\u4e9b\u547d\u540d\u76f4\u63a5\u6765\u81ea sampleinfo.csv\u7684 sample_info\u5217\u3002\n6.\u3010\u591a\u56e0\u7d20 ANOVA\u8bf4\u660e\u3011\u867d\u7136\u53ea\u6709\u5206\u7ec4\u4e00\u4e2a\u751f\u7269\u5b66\u56e0\u7d20\uff0c\u4f46\u4f9d\u7136\u6267\u884c\u5355\u56e0\u7d20 ANOVA\u4ee5\u63d0\u4f9b\u5168\u5c40\u663e\u8457\u6027\u8bc4\u4f30\uff0c\u4e3a\u540e\u7eed KEGG\u5bcc\u96c6\u5206\u6790\u63d0\u4f9b\u8865\u5145\u7684\u7edf\u8ba1\u6392\u5e8f\u4f9d\u636e\u3002\n7.\u3010\u6a21\u5757\u8854\u63a5\u3011\u5dee\u5f02\u5206\u6790\u7ed3\u679c\u8868\uff08limma_*.csv\uff09\u5c06\u4f5c\u4e3a\u6a21\u57575\uff08KEGG\u5bcc\u96c6\u5206\u6790\uff09\u7684\u8f93\u5165\u5206\u5b50\u5217\u8868\uff0c\u9700\u4fdd\u7559\u5b8c\u6574\u7684\u4ee3\u8c22\u7269 ID\u3001logFC\u3001pvalue_adj\u3001VIP\u503c\u7b49\u5217\u4fe1\u606f\u3002\u540c\u65f6\u4f9b\u6a21\u575710\uff08\u8868\u683c\u6c47\u603b\uff09\u548c\u6a21\u575711\uff08\u62a5\u544a\u751f\u6210\uff09\u5f15\u7528\u3002\n8.\u3010\u5305\u81ea\u52a8\u5b89\u88c5\u3011\u811a\u672c\u5f00\u5934\u8c03\u7528 install_packages.R\u6216\u901a\u8fc7 tryCatch\u81ea\u52a8\u5b89\u88c5\u7f3a\u5931\u5305\u3002CRAN\uff1aggplot2, ggrepel, ggVennDiagram, phe