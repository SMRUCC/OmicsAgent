{"Content":"OK，已确认数据。现在编写一个专注于 **Step2**的 R脚本，包含最优k的快速确定（复用验证指标）→ CMeans聚类 →表达模式剖面图 → ComplexHeatmap隶属度热图。","Role":"assistant","ToolCallId":null,"ToolCalls":[{"DeepSeekDSMLLeak":false,"FunctionArguments":{"content":"#!\/usr\/bin\/env Rscript\n# =============================================================================\n# CMeans Fuzzy Clustering - Step2: Clustering & Visualization\n# =============================================================================\n#读取预处理表达矩阵 →确定最优k → CMeans模糊聚类\n# →绘制每个簇的表达模式剖面图 →绘制隶属度热图\n# =============================================================================\n\nwork_dir <- \"G:\/OmicsWorks\/test\/metabolism\/demo\/tmp\/7_cmeans_fuzzy_clustering_analysis\"\nfig_dir <- \"G:\/OmicsWorks\/test\/metabolism\/demo\/analysis\/7_cmeans_fuzzy_clustering_analysis\/figures\"\nrscript_dir <- \"G:\/OmicsWorks\/agent\/rscript\"\ndir.create(work_dir, showWarnings = FALSE, recursive = TRUE)\ndir.create(fig_dir, showWarnings = FALSE, recursive = TRUE)\n\n# ----1.安装加载R包 ----\nfor (pkg in c(\"e1071\", \"ggplot2\", \"reshape2\", \"RColorBrewer\", \n \"gridExtra\", \"pheatmap\", \"cluster\")) {\n if (!requireNamespace(pkg, quietly = TRUE))\n install.packages(pkg, repos = \"https:\/\/cloud.r-project.org\", quiet = TRUE)\n}\nif (!requireNamespace(\"ComplexHeatmap\", quietly = TRUE)) {\n if (!requireNamespace(\"BiocManager\", quietly = TRUE))\n install.packages(\"BiocManager\", repos = \"https:\/\/cloud.r-project.org\")\n BiocManager::install(\"ComplexHeatmap\", ask = FALSE, update = FALSE)\n}\nlibrary(e1071); library(ggplot2); library(reshape2); library(RColorBrewer)\nlibrary(gridExtra); library(pheatmap); library(cluster)\nsuppressPackageStartupMessages(library(ComplexHeatmap))\n\nsource(file.path(rscript_dir, \"data_io.R\"))\nsource(file.path(rscript_dir, \"clustering.R\"))\ncat(\"Packages & helpers ready.\\n\\n\")\n\n# ----2.读取输入数据 ----\ncat(\"Reading expression matrix...\\n\")\nexpr_data <- load_expression_matrix(\n \"G:\/OmicsWorks\/test\/metabolism\/demo\/tmp\/preprocessed_expression.csv\")\ncat(sprintf(\" %d metabolites x %d samples\\n\", nrow(expr_data), ncol(expr_data)))\n\n#样本分组信息（从列名推断）\nsample_groups <- data.frame(\n Sample = colnames(expr_data),\n Group = factor(\n ifelse(grepl(\"^Fc16YH_CD\", colnames(expr_data)), \"CD\",\n ifelse(grepl(\"^Fc16YH_FE\", colnames(expr_data)), \"FE\", \"NC\")),\n levels = c(\"NC\", \"CD\", \"FE\")),\n stringsAsFactors = FALSE)\ncat(sprintf(\"Groups: NC=%d CD=%d FE=%d\\n\",\n sum(sample_groups$Group == \"NC\"),\n sum(sample_groups$Group == \"CD\"),\n sum(sample_groups$Group == \"FE\")))\n\n# ----3. z-score标准化 ----\ncat(\"Z-score normalization...\\n\")\nexpr_z <- t(scale(t(expr_data)))\nok <- complete.cases(expr_z)\nif (sum(!ok) >0) {\n expr_z <- expr_z[ok, , drop = FALSE]\n expr_data <- expr_data[ok, , drop = FALSE]\n cat(sprintf(\" Removed %d incomplete rows.\\n\", sum(!ok)))\n}\ncat(sprintf(\" Final matrix: %d x %d\\n\", nrow(expr_z), ncol(expr_z)))\nstopifnot(nrow(expr_z) >=10)\n\n# ----4.确定最优聚类数k ----\ncat(\"\\n=== Step1: Determining optimal k ===\\n\")\nset.seed(42)\nk_range <-2:15\nval <- data.frame(k = k_range, FPC = NA_real_, PE = NA_real_, Sil = NA_real_)\n\nfor (k in k_range) {\n res <- e1071::cmeans(expr_z, centers = k, m =2, iter.max =100)\n mem <- res$membership\n fpc <- sum(mem^2) \/ nrow(expr_z)\n pe <- -sum(mem * log(mem +1e-15)) \/ nrow(expr_z)\n sil <- tryCatch(mean(cluster::silhouette(res$cluster, dist(expr_z))[,3]),\n error = function(e) NA)\n val$FPC[val$k == k] <- fpc\n val$PE[val$k == k] <- pe\n val$Sil[val$k == k] <- sil\n cat(sprintf(\" k=%2d FPC=%.4f PE=%.4f Sil=%.4f\\n\", k, fpc, pe, sil))\n}\n\n#联合评分：FPC肘部 +轮廓系数\ndiffs <- abs(diff(val$FPC))\ndiffs_norm <- diffs \/ max(diffs)\nelbow_k <- k_range[which(diffs_norm <0.45)[1] +1]\nif (is.na(elbow_k) || elbow_k <3) elbow_k <-6\nsil_k3 <- val$k[val$k >=3][which.max(val$Sil[val$k >=3])]\ncand <- k_range[k_range >=3 & k_range <=10]\ncsil <- val$Sil[match(cand, k_range)]\ncelb <-1 - abs(cand - elbow_k) \/ max(1, max(cand) - min(cand))\ncsil_n <- (csil - min(csil, na.rm = TRUE)) \/ max(1, max(csil, na.rm = TRUE) - min(csil, na.rm = TRUE))\noptimal_k <- cand[which.max(0.6 * csil_n +0.4 * celb)]\ncat(sprintf(\" Elbow k=%d, Sil-best k=%d, Final optimal k=%d\\n\",\n elbow_k, sil_k3, optimal_k))\n\n#保存验证指标\nwrite.csv(val, file.path(work_dir, \"cmeans_validation_metrics.csv\"), row.names = FALSE)\n\n#绘制验证指标图\nml <- rbind(\n data.frame(k = val$k, v = val$FPC, M = \"FPC (higher is better)\"),\n data.frame(k = val$k, v = val$PE, M = \"PE (lower is better)\"),\n data.frame(k = val$k, v = val$Sil, M = \"Avg Silhouette (higher is better)\"))\np_met <- ggplot(ml, aes(k, v)) +\n geom_line(color = \"steelblue\", linewidth =0.8) +\n geom_point(color = \"steelblue\", size =2) +\n geom_point(data = subset(ml, k == optimal_k), color = \"red\", size =3) +\n facet_wrap(~ M, scales = \"free_y\", ncol =1) +\n scale_x_continuous(breaks = k_range) +\n labs(title = \"Cluster Validation Metrics\",\n subtitle = paste0(\"Optimal k = \", optimal_k, \" (red dot)\"),\n x = \"Number of clusters (k)\", y = \"Value\") +\n theme_bw(base_size =12) +\n theme(plot.title = element_text(hjust =0.5, face = \"bold\"),\n plot.subtitle = element_text(hjust =0.5, color = \"red\"),\n strip.text = element_text(face = \"bold\"),\n panel.grid.minor = element_blank())\nggsave(file.path(fig_dir, \"CMeans_validation_metrics.pdf\"), p_met, width =8, height =8)\nggsave(file.path(fig_dir, \"CMeans_validation_metrics.png\"), p_met, width =8, height =8, dpi =300)\ncat(\" Validation metrics plot saved.\\n\")\n\n# ----5. CMeans模糊聚类 ----\ncat(sprintf(\"\\n=== Step2: CMeans clustering (k=%d) ===\\n\", optimal_k))\nset.seed(42)\ncres <- e1071::cmeans(expr_z, centers = optimal_k, m =2, iter.max =100)\n\n#处理空簇：移除没有代谢物的质心\nnonempty <- sort(unique(cres$cluster))\nn_actual <- length(nonempty)\nif (n_actual < optimal_k) {\n cat(sprintf(\" Note: %d clusters had members (k=%d requested)\\n\", n_actual, optimal_k))\n}\n\n#重新编号簇标签 (1..n_actual)\ncluster_labels <- setNames(seq_len(n_actual), nonempty)[as.character(cres$cluster)]\nnames(cluster_labels) <- names(cres$cluster)\n\n#提取隶属度矩阵和中心（仅非空簇）\nmembership_mat <- cres$membership[, nonempty, drop = FALSE]\ncolnames(membership_mat) <- paste0(\"C\", seq_len(n_actual))\ncenters_mat <- cres$centers[nonempty, , drop = FALSE]\nrownames(centers_mat) <- paste0(\"C\", seq_len(n_actual))\n\ncat(\" Cluster sizes:\\n\")\nprint(table(cluster_labels))\ncat(sprintf(\" Converged: %s in %d iterations\\n\", cres$converged, cres$iter))\n\n#保存完整结果\nresult <- list(\n cluster = cluster_labels,\n membership = membership_mat,\n centers = centers_mat,\n iter = cres$iter,\n converged = cres$converged,\n optimal_k = n_actual,\n validation = val\n)\nsaveRDS(result, file.path(work_dir, \"cmeans_result.rds\"))\n\n#保存簇分配表\ncluster_df <- data.frame(\n Metabolite = names(cluster_labels),\n Cluster = cluster_labels,\n MaxMembership = apply(membership_mat,1, max),\n stringsAsFactors = FALSE)\nwrite.csv(cluster_df, file.path(work_dir, \"cmeans_cluster_assignments.csv\"), row.names = FALSE)\ncat(\" Cluster assignments saved.\\n\")\n\n# ----6.表达模式剖面图 ----\ncat(\"\\n=== Step3: Expression profile plots ===\\n\")\n#样本排序：NC → CD → FE\nsamp_order <- c()\nfor (g in c(\"NC\", \"CD\", \"FE\"))\n samp_order <- c(samp_order, sample_groups$Sample[sample_groups$Group == g])\n\nplot_list <- list()\nfor (k in seq_len(n_actual)) {\n mems <- names(cluster_labels)[cluster_labels == k]\n if (length(mems) ==0) next\n  \n esub <- expr_z[mems, , drop = FALSE]\n elong <- melt(esub)\n colnames(elong) <- c(\"Metabolite\", \"Sample\", \"Expression\")\n elong$Membership <- membership_mat[mems[elong$Metabolite], k]\n  \n #聚类中心线\n ctr <- data.frame(\n Metabolite = \"Center\",\n Sample = colnames(expr_z),\n Expression = as.numeric(centers_mat[k, ]),\n Membership =1,\n stringsAsFactors = FALSE)\n  \n pdata <- rbind(elong, ctr)\n pdata$Sample <- factor(pdata$Sample, levels = samp_order)\n  \n p <- ggplot() +\n #灰色细线 =各代谢物表达轨迹\n geom_line(data = subset(pdata, Metabolite != \"Center\"),\n aes(x = Sample, y = Expression, group = Metabolite, color = Membership),\n alpha =0.25, linewidth =0.3) +\n #黑色粗线 =聚类中心\n geom_line(data = subset(pdata, Metabolite == \"Center\"),\n aes(x = Sample, y = Expression, group =1),\n color = \"black\", linewidth =1.5) +\n scale_color_gradient(low = \"grey80\", high = \"darkred\", limits = c(0,1)) +\n labs(title = paste0(\"Cluster \", k, \" (n = \", length(mems), \" metabolites)\"),\n x = \"Sample\", y = \"z-score Expression\", color = \"Membership\") +\n theme_bw(base_size =10) +\n theme(plot.title = element_text(hjust =0.5, face = \"bold\", size =11),\n axis.text.x = element_text(angle =45, hjust =1, size =7),\n legend.position = \"right\")\n plot_list[[k]] <- p\n}\n\n#拼图\nnc_plot <- if (n_actual <=4)2 else if (n_actual <=6)3 else4\nnr_plot <- ceiling(n_actual \/ nc_plot)\npp <- gridExtra::marrangeGrob(plot_list, nrow = nr_plot, ncol = nc_plot, top = NULL)\nggsave(file.path(fig_dir, \"CMeans_profiles.pdf\"), pp, width =4 * nc_plot, height =3.5 * nr_plot)\nggsave(file.path(fig_dir, \"CMeans_profiles.png\"), pp, width =4 * nc_plot, height =3.5 * nr_plot, dpi =300)\ncat(\" Profile plots saved: CMeans_profiles.pdf\/png\\n\")\n\n# ----7.隶属度热图 ----\ncat(\"\\n=== Step4: Membership heatmap ===\\n\")\n#按簇标签排序，簇内按隶属度降序\nord <- order(cluster_labels, -apply(membership_mat,1, max))\nmo <- membership_mat[ord, , drop = FALSE]\n\n#列注释 =每个代谢物所属簇（用于t(mo)的列）\ncol_cluster <- factor(cluster_labels[ord], levels = seq_len(n_actual))\nnames(col_cluster) <- rownames(mo)\n\n#颜色方案\ncluster_cols <- setNames(brewer.pal(max(n_actual,3), \"Set2\")[seq_len(n_actual)],\n as.character(seq_len(n_actual)))\nmem_col_fun <- circlize::colorRamp2(c(0,0.5,1), c(\"white\", \"orange\", \"darkred\"))\n\n#热图注释\nha_col <- HeatmapAnnotation(\n Cluster = col_cluster,\n col = list(Cluster = cluster_cols),\n show_annotation_name = FALSE)\n\nha_row <- rowAnnotation(\n Cluster = as.character(seq_len(n_actual)),\n col = list(Cluster = cluster_cols),\n show_annotation_name = TRUE,\n annotation_label = \"CMeans\"\n)\n\n#绘制热图（行=簇，列=代谢物）\npdf(file.path(fig_dir, \"CMeans_membership_heatmap.pdf\"),\n width =12, height = max(4, n_actual *1.2))\nht <- Heatmap(t(mo),\n name = \"Membership\",\n col = mem_col_fun,\n top_annotation = ha_col,\n left_annotation = ha_row,\n show_row_names = TRUE,\n show_column_names = FALSE,\n row_names_gp = gpar(fontsize =10, fontface = \"bold\"),\n cluster_rows = TRUE,\n cluster_columns = FALSE,\n column_split = col_cluster,\n column_title_gp = gpar(fontsize =9),\n heatmap_legend_param = list(direction = \"vertical\"))\ndraw(ht)\ndev.off()\n\npng(file.path(fig_dir, \"CMeans_membership_heatmap.png\"),\n width =3600, height = max(1200, n_actual *360), res =300)\ndraw(ht)\ndev.off()\ncat(\" Membership heatmap saved: CMeans_membership_heatmap.pdf\/png\\n\")\n\n# ----8.汇总输出 ----\ncat(\"\\n========================================\\n\")\ncat(\"CMeans Step2 Complete\\n\")\ncat(\"========================================\\n\")\ncat(sprintf(\" Optimal k requested: %d\\n\", optimal_k))\ncat(sprintf(\" Actual clusters: %d\\n\", n_actual))\ncat(sprintf(\" Metabolites: %d\\n\", nrow(expr_z)))\ncat(sprintf(\" CSV output: %s\\n\", file.path(work_dir, \"cmeans_cluster_assignments.csv\")))\ncat(sprintf(\" RDS result: %s\\n\", file.path(work_dir, \"cmeans_result.rds\")))\ncat(sprintf(\" Figures dir: %s\\n\\n\", fig_dir))\n\nfor (f in list.files(fig_dir, pattern = \"\\\\.(pdf|png)$\"))\n cat(sprintf(\" %s\\n\", file.path(fig_dir, f)))\ncat(\"\\nDone.\\n\")\n","path":"G:\/OmicsWorks\/test\/metabolism\/demo\/tmp\/7_cmeans_fuzzy_clustering_analysis\/scripts\/step2_cmeans_clustering.R"},"FunctionName":"write_file","Id":"call_00_OkiwpfHuPPfuGqoxy2L63970"}]}
