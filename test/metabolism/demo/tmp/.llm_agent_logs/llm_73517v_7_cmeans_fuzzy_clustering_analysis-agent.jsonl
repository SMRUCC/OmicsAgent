ster_rows = TRUE,\n cluster_columns = FALSE,\n column_split = col_cluster,\n column_title_gp = gpar(fontsize =9),\n heatmap_legend_param = list(direction = \"vertical\"))\ndraw(ht)\ndev.off()\n\npng(file.path(fig_dir, \"CMeans_membership_heatmap.png\"),\n width =3600, height = max(1200, actual_k *360), res =300)\ndraw(ht)\ndev.off()\ncat(\" Membership heatmap saved.\\n\")\n","path":"G:\/OmicsWorks\/test\/metabolism\/demo\/tmp\/7_cmeans_fuzzy_clustering_analysis\/scripts\/fix_heatmap.R"},"FunctionName":"write_file","Id":"call_00_4TZsmt7JJ0WSVaOj2xk68422"}]}
