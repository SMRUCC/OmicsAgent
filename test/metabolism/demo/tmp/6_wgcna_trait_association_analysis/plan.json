DF\u3002\",\n \"goal\": \"\u6784\u5efa\u5171\u8868\u8fbe\u7f51\u7edc\u5e76\u8bc6\u522b\u4ee3\u8c22\u6a21\u5757\uff0c\u5173\u8054\u6a21\u5757\u4e0e\u5206\u7ec4\u6027\u72b6\u53ca\u901a\u8def\u6d3b\u6027\uff0c\u901a\u8fc7\u56de\u5f52\u91cf\u5316\u89e3\u91ca\u80fd\u529b\uff0c\u53ef\u89c6\u5316\u5173\u952e\u6a21\u5757\u7684hub\u4ee3\u8c22\u7269\u7f51\u7edc\u3002\"\n },\n {\n \"action\": \"\u4ecemetabolites.csv\u63d0\u53d6kegg_category\u5217\u6784\u5efa22\u4e2a\u901a\u8def\u7684\u80cc\u666f\u6620\u5c04\u8868\u3002\u5bf9\u6bcf\u4e2aWGCNA\u6a21\u5757\u7684\u4ee3\u8c22\u7269\uff08\u524d\u666f\u96c6\uff09vs\u5168\u90e82059\u4ee3\u8c22\u7269\uff08\u80cc\u666f\u96c6\uff09\uff0c\u7528Fisher\u7cbe\u786e\u68c0\u9a8c\u505aKEGG\u901a\u8def\u5bcc\u96c6\u5206\u6790\u3002\u5408\u5e76\u6240\u6709\u6a21\u5757\u7ed3\u679c\u4e3akegg_enrichment_all_modules.csv\u3002\u7528ggplot2\u7ed8\u5236\u5bcc\u96c6\u70b9\u56fe\uff08X=\u901a\u8def\uff0cY=\u6a21\u5757\u989c\u8272\uff0c\u70b9\u5927\u5c0f=\u4ee3\u8c22\u7269\u6570\uff0c\u989c\u8272=-log10(p_adj)\uff09\uff0c\u4fdd\u5b58PNG(300dpi)+PDF\u3002\u7ed3\u679c\u4f9b\u6a21\u57577(CMeans)\u5173\u8054\u5bf9\u6bd4\u53ca\u6a21\u575710/11\u5f15\u7528\u3002\",\n \"goal\": \"\u8bc6\u522b\u5404WGCNA\u6a21\u5757\u663e\u8457\u5bcc\u96c6\u7684KEGG\u4ee3\u8c22\u901a\u8def\uff0c\u5c06\u5171\u8868\u8fbe\u6a21\u5757\u4e0e\u751f\u7269\u5b66\u529f\u80fd\u8054\u7cfb\u8d77\u6765\uff0c\u63ed\u793a\u9ad8\u94c1\u996e\u98df\u5f71\u54cdCDI\u7684\u5173\u952e\u4ee3\u8c22\u901a\u8def\u6a21\u5757\u3002\"\n }\n ],\n \"notes\": \"1.\u3010MAD\u7b5b\u9009\u8bf4\u660e\u3011\u8868\u8fbe\u77e9\u9635\u4ec52059\u4e2a\u4ee3\u8c22\u7269\uff0c\u4e0d\u8db320000\u9608\u503c\uff0c\u6545\u5168\u91cf\u9009\u53d6\u4e0d\u7b5b\u9009\u30022.\u3010\u7f51\u7edc\u7c7b\u578b\u3011\u4f7f\u7528'signed'\u7f51\u7edc\uff0c\u56e0\u4e2d\u4f4d\u6570\u7f29\u653e\u540e\u6570\u636e\u542b\u6b63\u8d1f\u53cc\u5411\u53d8\u5316\uff080.217~2.365\uff09\uff0csigned\u7f51\u7edc\u4fdd\u7559\u6b63\u8d1f\u76f8\u5173\u751f\u72