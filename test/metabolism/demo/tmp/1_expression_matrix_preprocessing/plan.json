{/* 模块名称 */"module_name": "Expression Matrix Preprocessing",/* 分析目标描述 */"goal": "\u5bf9\u9ad8\u94c1\u996e\u98df\u5e72\u9884\u8270\u96be\u68ad\u83cc\u611f\u67d3\u5c0f\u9f20\u6a21\u578b\u7684\u4ee3\u8c22\u7ec4\u8868\u8fbe\u77e9\u9635\u8fdb\u884c\u6807\u51c6\u5316\u9884\u5904\u7406\uff0c\u5305\u62ec\u7f3a\u5931\u503c\u586b\u5145\u3001\u5217\u548c\u5f52\u4e00\u5316\u3001log\u8f6c\u6362\u53ca\u4e2d\u4f4d\u6570\u7f29\u653e\uff0c\u751f\u6210\u53ef\u4f9b\u4e0b\u6e38PCA\u3001LIMMA\u3001WGCNA\u3001CMeans\u5206\u6790\u7684\u6807\u51c6\u5316\u8868\u8fbe\u77e9\u9635\u3002",/* 所需输入文件路径列表 */"input_files": ["G:/OmicsWorks/test/metabolism/expression.csv","G:/OmicsWorks/test/metabolism/sampleinfo.csv"],/* 预期输出文件路径列表 */"output_files": ["G:/OmicsWorks/test/metabolism/demo/tmp/preprocessed_expression.csv"],"execution_steps": [{"action": "\u6b65\u9aa41 -\u7f3a\u5931\u503c\u586b\u5145\uff1a\u6309\u884c\uff08\u4ee3\u8c22\u7269\u5206\u5b50\uff09\u9010\u884c\u68c0\u6d4b\u7f3a\u5931\u503c\uff0c\u5bf9\u8be5\u884c\u6240\u6709\u975e\u7f3a\u5931\u6b63\u503c\u53d6\u6700\u5c0f\u503c\u7684\u4e00\u534a\u4f5c\u4e3a\u586b\u5145\u503c\u3002\u5982\u67d0\u884c\u6240\u6709\u503c\u5747\u4e3a\u7f3a\u5931\u6216\u96f6\uff0c\u5219\u586b\u5145\u4e3a0\u3002","goal": "\u786e\u4fdd\u8868\u8fbe\u77e9\u9635\u5b8c\u6574\u65e0\u7f3a\u5931\u503c\uff0c\u907f\u514d\u4e0b\u6e38\u5206\u6790\u56e0NA\u503c\u62a5\u9519\u3002\u867d\u7136\u5f53\u524d\u6570\u636e\u7ecf\u68c0\u6d4b\u65e0NA\u503c\uff0c\u4f46\u8be5\u6b65\u9aa4\u4f5c\u4e3a\u6807\u51c6\u8d28\u63a7\u6d41\u7a0b\u7684\u4e00\u90e8\u5206\u4fdd\u7559\u6267\u884c\u3002","rscript_path": null},{"action": "\u6b65\u9aa42 -\u5217\u603b\u548c\u5f52\u4e00\u5316\uff1a\u5bf9\u586b\u5145\u540e\u7684\u8868\u8fbe\u77e9\u9635\u6309\u5217\uff08\u6837\u672c\uff09\u6c42\u548c\uff0c\u5c06\u6bcf\u4e2a\u6837\u672c\u4e2d\u6240\u6709\u4ee3\u8c22\u7269\u7684\u8868\u8fbe\u503c\u9664\u4ee5\u8be5\u6837\u672c\u603b\u548c\uff0c\u5e76\u4e58\u4ee5\u7f29\u653e\u56e0\u5b501e6\u8f6c\u6362\u4e3a\u76f8\u5bf9\u4e30\u5ea6\uff08ppm\u5355\u4f4d\uff09\u3002","goal": "\u6d88\u9664\u6837\u672c\u95f4\u603b\u4f53\u4ee3\u8c22\u7269\u8f7d\u91cf\u5dee\u5f02\uff0c\u4f7f\u4e0d\u540c\u6837\u672c\u7684\u8868\u8fbe\u503c\u5177\u6709\u53ef\u6bd4\u6027\u3002\u4ee3\u8c22\u7ec4\u5b66\u6570\u636e\u5e38\u53d7\u6837\u672c\u5236\u5907\u3001\u4eea\u5668\u7075\u654f\u5ea6\u7b49\u7cfb\u7edf\u8bef\u5dee\u5f71\u54cd\uff0c\u5217\u548c\u5f52\u4e00\u5316\u53ef\u6821\u6b63\u6b64\u7c7b\u6280\u672f\u53d8\u5f02\u3002","rscript_path": null},{"action": "\u6b65\u9aa43 - Log\u8f6c\u6362\u4e0e\u4e2d\u4f4d\u6570\u7f29\u653e\uff1a\u68c0\u6d4b\u5230\u6700\u5927\u503c(283.38)>100\uff0c\u8868\u660e\u6570\u636e\u672a\u7ecf\u8fc7log\u8f6c\u6362\u3002\u5148\u6267\u884clog2(x+1)\u8f6c\u6362\u4f7f\u6570\u636e\u5206\u5e03\u66f4\u63a5\u8fd1\u6b63\u6001\uff1b\u518d\u6309\u884c\uff08\u4ee3\u8c22\u7269\uff09\u8ba1\u7b97\u4e2d\u4f4d\u6570\uff0c\u5c06\u6bcf\u4e2a\u4ee3\u8c22\u7269\u5728\u6240\u6709\u6837\u672c\u4e2d\u7684\u503c\u9664\u4ee5\u5176\u4e2d\u4f4d\u6570\uff0c\u5b8c\u6210\u4e2d\u4f4d\u6570\u7f29\u653e\u3002","goal": "log\u8f6c\u6362\u538b\u7f29\u6570\u636e\u52a8\u6001\u8303\u56f4\u3001\u7a33\u5b9a\u65b9\u5dee\uff0c\u6ee1\u8db3\u4e0b\u6e38\u7edf\u8ba1\u5206\u6790\u65b9\u6cd5\u5bf9\u6b63\u6001\u6027\u7684\u5047\u8bbe\u8981\u6c42\uff1b\u4e2d\u4f4d\u6570\u7f29\u653e\u4f7f\u4e0d\u540c\u91cf\u7ea7\u4ee3\u8c22\u7269\u95f4\u7684\u8868\u8fbe\u503c\u5177\u6709\u53ef\u6bd4\u6027\uff0c\u6d88\u9664\u4ee3\u8c22\u7269\u95f4\u7edd\u5bf9\u4e30\u5ea6\u7684\u91cf\u7ea7\u5dee\u5f02\uff0c\u9002\u5408\u70ed\u56fe\u53ef\u89c6\u5316\u548c\u805a\u7c7b\u5206\u6790\u3002","rscript_path": null}],"notes": "\u7279\u522b\u6ce8\u610f\uff1a\n1.\u6837\u672c\u4fe1\u606f\u8868\u4e2d\u67093\u4e2aQC\u6837\u672c(Fc16YH_QC01-3)\uff0c\u4f46\u8868\u8fbe\u77e9\u9635\u4e2d\u4ec5\u670918\u4e2a\u751f\u7269\u5b66\u6837\u672c(CD/FE/NC\u54046\u4e2a)\uff0cQC\u6837\u672c\u672a\u5305\u542b\u5728\u8868\u8fbe\u77e9\u9635\u4e2d\uff0c\u9884\u5904\u7406\u65f6\u4ec5\u5904\u740618\u4e2a\u751f\u7269\u5b66\u6837\u672c\uff0cQC\u7ec4\u4fe1\u606f\u4fdd\u7559\u4e8esampleinfo.csv\u4f9b\u540e\u7eed\u8d28\u63a7\u8bc4\u4f30\u4f7f\u7528\u3002\n2.\u6570\u636e\u96c6\u4e3a\u4ee3\u8c22\u7ec4\u5b66\u6570\u636e(2059\u4e2a\u4ee3\u8c22\u7269\u5206\u5b50)\uff0c\u672a\u53d1\u73b0\u7528\u6237\u6307\u5b9a\u7684\u7279\u6b8a\u9884\u5904\u7406\u4f8b\u5916\u60c5\u51b5\uff0c\u6309\u6807\u51c6\u56db\u6b65\u6d41\u7a0b\u5904\u7406\u3002\n3.\u9884\u5904\u7406\u540e\u7684\u77e9\u9635\u4fdd\u5b58\u4e3a preprocessed_expression.csv\uff0c\u4f5c\u4e3a\u4e0b\u6e38\u6a21\u57572(PCA)\u30014(LIMMA)\u30016(WGCNA)\u30017(CMeans)\u7684\u8f93\u5165\u3002\n4.\u4e09\u4e2a\u5206\u7ec4\u4e3a\uff1aCD\u7ec4(Clostridium difficile infection)\u3001FE\u7ec4(high iron diet before)\u3001NC\u7ec4(Standard control)\u3002",/* 阶段性总结文本 */"conclusion": "##\u6a21\u5757\u4e00\uff1a\u8868\u8fbe\u77e9\u9635\u9884\u5904\u7406 \u2014\u9636\u6bb5\u6027\u603b\u7ed3###\u4e00\u3001\u6570\u636e\u9884\u5904\u7406\u6574\u4f53\u6982\u51b5\u672c\u7814\u7a76\u4f7f\u7528\u7684\u4ee3\u8c22\u7ec4\u5b66\u8868\u8fbe\u77e9\u9635\u5305\u542b **2,059\u4e2a\u4ee3\u8c22\u7269\u5206\u5b50**\u548c **18\u4e2a\u751f\u7269\u5b66\u6837\u672c**\uff0c\u5206\u522b\u6765\u81ea\u4e09\u4e2a\u5b9e\u9a8c\u5206\u7ec4\uff1a**CD\u7ec4**\uff08\u8270\u96be\u68ad\u83cc\u611f\u67d3\u7ec4\uff0cFc16YH_CD1~CD6\uff0cn=6\uff09\u3001**FE\u7ec4**\uff08\u611f\u67d3\u524d\u9ad8\u94c1\u996e\u98df\u5e72\u9884\u7ec4\uff0cFc16YH_FE1~FE6\uff0cn=6\uff09\u548c**NC\u7ec4**\uff08\u5065\u5eb7\u5bf9\u7167\uff0cFc16YH_NC1~NC6\uff0cn=6\uff09\u3002\u6837\u672c\u4fe1\u606f\u8868\u4e2d\u8fd8\u5305\u542b3\u4e2aQC\u8d28\u63a7\u6837\u672c\uff08Fc16YH_QC01~QC03\uff09\uff0c\u4f46QC\u6837\u672c\u672a\u51fa\u73b0\u5728\u8868\u8fbe\u77e9\u9635\u4e2d\uff0c\u4ec5\u7528\u4e8e\u5b9e\u9a8c\u6570\u636e\u91c7\u96c6\u7a33\u5b9a\u6027\u7684\u8bc4\u4f30\uff0c\u4e0d\u53c2\u4e0e\u540e\u7eed\u751f\u7269\u5b66\u5206\u6790\u3002\n\n\u539f\u59cb\u8868\u8fbe\u77e9\u9635\u7684\u4ee3\u8c22\u7269\