{/* 模块名称 */"module_name": "Comparison Group Design",/* 分析目标描述 */"goal": "\u57fa\u4e8e\u6837\u672c\u4fe1\u606f\u8868\u4e2d\u7684\u5206\u7ec4\u4fe1\u606f\uff08NC\u5065\u5eb7\u5bf9\u7167\u3001CD\u8270\u96be\u68ad\u83cc\u611f\u67d3\u3001FE\u611f\u67d3\u524d\u9ad8\u94c1\u996e\u98df\u5e72\u9884\uff09\uff0c\u8bbe\u8ba13\u7ec4\u5177\u6709\u660e\u786e\u751f\u7269\u5b66\u610f\u4e49\u7684\u4e24\u4e24\u6bd4\u5bf9\u65b9\u6848\u3002\u6838\u5fc3\u76ee\u6807\u662f\u63ed\u793a\u9ad8\u94c1\u996e\u98df\u5982\u4f55\u901a\u8fc7\u8c03\u8282\u80a0\u9053\u4ee3\u8c22\u7269\u8c31\uff08\u94c1\u7a33\u6001\u4ee3\u8c22\u7269\u3001\u80c6\u6c41\u9178\u3001\u77ed\u94fe\u8102\u80aa\u9178\u7b49\uff09\u6765\u6539\u53d8\u5bbf\u4e3b\u5bf9\u8270\u96be\u68ad\u83cc\u611f\u67d3\uff08CDI\uff09\u7684\u6613\u611f\u6027\u548c\u75be\u75c5\u4e25\u91cd\u7a0b\u5ea6\uff0c\u4e3a\u540e\u7eedLIMMA\u5dee\u5f02\u5206\u6790\u548cKEGG GSVA\u901a\u8def\u5bcc\u96c6\u5206\u6790\u63d0\u4f9b\u6bd4\u5bf9\u65b9\u6848\u4f9d\u636e\u3002",/* 所需输入文件路径列表 */"input_files": ["G:/OmicsWorks/test/metabolism/sampleinfo.csv","G:/OmicsWorks/test/metabolism/expression.csv","G:/OmicsWorks/test/metabolism/demo/tmp/preprocessed_expression.csv"],/* 预期输出文件路径列表 */"output_files": ["G:/OmicsWorks/test/metabolism/demo/tmp/3_comparison_group_design/tables/comparison_design.csv","G:/OmicsWorks/test/metabolism/demo/analysis/3_comparison_group_design/comparison_design_visualization.png"],"execution_steps": [],"notes": "1.\u3010QC\u6392\u9664\u3011QC\u6837\u672c\uff08Fc16YH_QC01~QC03\uff09\u4ec5\u7528\u4e8e\u5b9e\u9a8c\u6570\u636e\u91c7\u96c6\u7a33\u5b9a\u6027\u8bc4\u4f30\uff0c\u4e0d\u53c2\u4e0e\u4efb\u4f55\u751f\u7269\u5b66\u6bd4\u5bf9\u5206\u6790\uff0c\u5728\u540e\u7eed\u5dee\u5f02\u5206\u6790\u524d\u5e94\u4ece\u8868\u8fbe\u77e9\u9635\u4e2d\u5254\u9664\u3002\n2.\u3010\u6837\u672c\u91cf\u5145\u8db3\u3011\u4e09\u4e2a\u751f\u7269\u5b66\u5206\u7ec4\uff08NC\u3001CD\u3001FE\uff09\u5404\u67096\u4e2a\u72ec\u7acb\u751f\u7269\u5b66\u91cd\u590d\uff08n=6\uff09\uff0c\u517118\u4e2a\u6837\u672c\uff0c\u6ee1\u8db3LIMMA\u7b49\u7edf\u8ba1\u65b9\u6cd5\u5bf9\u6837\u672c\u91cf\u7684\u8981\u6c42\uff0c\u7edf\u8ba1\u6548\u529b\u5145\u8db3\u3002\n3.\u3010\u6a2a\u622a\u9762\u8bbe\u8ba1\u3011\u672c\u6570\u636e\u96c6\u4e3a\u5355\u4e00\u65f6\u95f4\u70b9\u91c7\u96c6\u7684\u6a2a\u622a\u9762\u8bbe\u8ba1\uff0c\u672a\u5305\u542b\u4e0d\u540c\u65f6\u95f4\u70b9\u7684\u91c7\u6837\u6570\u636e\uff0c\u56e0\u6b64\u65e0\u65f6\u95f4\u5e8f\u5217\u6bd4\u5bf9\u8bbe\u8ba1\u3002\n4.\u3010\u6bd4\u5bf9\u4f18\u5148\u7ea7\u3011FE_vs_CD\u4e3a\u6700\u6838\u5fc3\u6bd4\u5bf9\uff08\u4f18\u5148\u7ea71\uff09\uff0c\u76f4\u63a5\u56de\u7b54\u9ad8\u94c1\u996e\u98df\u5982\u4f55\u5f71\u54cdCDI\u4ee3\u8c22\u7ec4\u7684\u6838\u5fc3\u79d1\u5b66\u95ee\u9898\uff1bCD_vs_NC\u4e3a\u6a21\u578b\u9a8c\u8bc1\u6bd4\u5bf9\uff08\u4f18\u5148\u7ea72\uff09\uff0c\u4f5c\u4e3a\u57fa\u7ebf\u53c2\u7167\uff1bFE_vs_NC\u4e3a\u6574\u4f53\u6548\u5e94\u6bd4\u5bf9\uff08\u4f18\u5148\u7ea73\uff09\uff0c\u7528\u4e8e\u8bc4\u4f30\u7efc\u5408\u6270\u52a8\u5e45\u5ea6\u3002\n5.\u3010\u4e0b\u6e38\u8854\u63a5\u3011\u672c\u6a21\u5757\u8f93\u51fa\u7684comparison_design.csv\u5c06\u4f5c\u4e3a\u6a21\u57574\uff08LIMMA\u5dee\u5f02\u5206\u6790\uff09\u548c\u6a21\u57575\uff08KEGG GSVA\u5dee\u5f02\u5206\u6790\uff09\u7684\u6807\u51c6\u8f93\u5165\uff0c\u56e0\u6b64\u5728\u8bbe\u8ba1\u65f6\u5df2\u786e\u4fdd\u6bd4\u5bf9\u547d\u540d\u89c4\u8303\u3001\u5206\u7ec4\u540d\u79f0\u4e0e\u6837\u672c\u4fe1\u606f\u8868\u5b8c\u5168\u4e00\u81f4\uff08\u5305\u62ec\u5927\u5c0f\u5199\u548c\u7a7a\u683c\uff09\u3002\n6.\u3010\u5efa\u8bae\u9608\u503c\u3011\u540e\u7eedLIMMA\u5206\u6790\u5efa\u8bae\u91c7\u7528Benjamini-Hochberg FDR\u6821\u6b63\uff0c\u663e\u8457\u9608\u503c\u8bbe\u4e3aadj.P.Val <0.05\u4e14|log2FC| >1\uff0c\u4ee5\u786e\u4fdd\u5dee\u5f02\u4ee3\u8c22\u7269\u7b5b\u9009\u7684\u7edf\u8ba1\u5b66\u53ef\u9760\u6027\u3002",/* 阶段性总结文本 */"conclusion": "##\u6a21\u5757\u4e09\uff1a\u6bd4\u5bf9\u7ec4\u8bbe\u8ba1 \u2014\u9636\u6bb5\u6027\u603b\u7ed3###\u4e00\u3001\u6574\u4f53\u8bbe\u8ba1\u601d\u8def\u672c\u7814\u7a76\u57fa\u4e8e\u4ee3\u8c22\u7ec4\u5b66\u8868\u8fbe\u77e9\u9635\uff082,059\u4e2a\u4ee3\u8c22\u7269 \u00d718\u4e2a\u751f\u7269\u5b66\u6837\u672c\uff09\uff0c\u4ece\u6837\u672c\u4fe1\u606f\u8868\u4e2d\u8bc6\u522b\u51fa\u4e09\u4e2a\u53ef\u7528\u751f\u7269\u5b66\u5206\u7ec4\uff1a**NC\u7ec4**\uff08\u5065\u5eb7\u5bf9\u7167\uff0cn=6\uff09\u3001**CD\u7ec4**\uff08\u8270\u96be\u68ad\u83cc\u611f\u67d3\uff0cn=6\uff09\u548c**FE\u7ec4**\uff08\u611f\u67d3\u524d\u9ad8\u94c1\u996e\u98df\u5e72\u9884\uff0cn=6\uff09\u30023\u4e2aQC\u8d28\u63a7\u6837\u672c\u4ec5\u7528\u4e8e\u6280\u672f\u7a33\u5b9a\u6027\u8bc4\u4f30\uff0c\u4e0d\u53c2\u4e0e\u751f\u7269\u5b66\u5206\u6790\u3002\n\n\u56f4\u7ed5\"\u9ad8\u94c1\u996e\u98df\u5982\u4f55\u8c03\u8282CDI\u6613\u611f\u6027\"\u8fd9\u4e00\u6838\u5fc3\u79d1\u5b66\u95ee\u9898\uff0c\u6211\u4eec\u8bbe\u8ba1\u4e86**3\u7ec4\u4e24\u4e24\u6bd4\u5bf9**\uff0c\u5f62\u6210\u5c42\u6b21\u5316\u7684\u6bd4\u5bf9\u7b56\u7565\uff1a\u4ee5 **FE_vs_CD**\u4e3a\u4e00\u7ea7\u6838\u5fc3\u6bd4\u5bf9\uff08\u76f4\u63a5\u56de\u7b54\u9ad8\u94c1\u996e\u98df\u5bf9CDI\u4ee3\u8c22\u7ec4\u7684\u5f71\u54cd\uff09\uff0c**CD_vs_NC**\u4e3a\u4e8c\u7ea7\u6a21\u578b\u9a8c\u8bc1\uff08\u5efa\u7acbCDI\u611f\u67d3\u57fa\u7ebf\u4ee3\u8c22\u7279\u5f81\uff09\uff0c**FE_vs_NC**\u4e3a\u4e09\u7ea7\u6574\u4f53\u6548\u5e94\u8bc4\u4f30\uff08\u8861\u91cf\u9ad8\u94c1\u996e\u98df+CDI\u7684\u7efc\u5408\u6270\u52a8\uff09\u3002\u4e09\u7ec4\u6bd4\u5bf9\u76f8\u4e92\u5370\u8bc1\uff0c\u6784\u6210\u4ece\"\u611f\u67d3\u57fa\u7ebf \u2192\u996e\u98df\u5e72\u9884\u6548\u5e94 \u2192\u7efc\u5408\u6270\u52a8\"\u7684\u5b8c\u6574\u8bc1\u636e\u94fe\u3002\n\n###\u4e8c\u3001\u5404\u7ec4\u6bd4\u5bf9\u7684\u751f\u7269\u5b66\u4f9d\u636e\u4e0e\u9884\u671f\u53d1\u73b0**1. FE_vs_CD\uff08\u6838\u5fc3\u6bd4\u5bf9\uff0c\u4f18\u5148\u7ea7\u6700\u9ad8\uff09**\n\nFE\u7ec4\u4e0eCD\u7ec4\u5747\u611f\u67d3\u4e86\u8270\u96be\u68ad\u83cc\uff0c\u552f\u4e00\u53d8\u91cf\u4e3aFE\u7ec4\u5728\u611f\u67d3\u524d\u63a5\u53d7\u4e86400 mg/kg\u786b\u9178\u4e9a\u94c1\u7684\u9ad8\u94c1\u996e\u98df\u3002\u6b64\u6bd4\u5bf9\u7684\u751f\u7269\u5b66\u610f\u4e49\u5728\u4e8e\uff1a\u77e5\u8bc6\u5e93\u660e\u786e\u63ed\u793a\u9ad8\u94c1\u996e\u98df\u53ef\u901a\u8fc7\u589e\u52a0\u80a0\u9053\u5185\u94c1\u6d53\u5ea6\uff0c\u7ecfFeoAB/Fhu/Fur\u94c1\u6444\u53d6\u7cfb\u7edf\u76f4\u63a5\u4fc3\u8fdbC. difficile\u751f\u957f\uff08\u4f53\u5916Fe\u00b3\u207a100 \u03bcM\u65f6CFU\u589e13.8\u500d\uff09\uff0c\u4e0a\u8c03tcdA/tcdB\u6bd2\u7d20\u8868\u8fbe\uff08\u6bd2\u7d20A\u86cb\u767d\u589e8.6\u500d\uff09\uff0c\u540c\u65f6\u6539\u53d8\u5bbf\u4e3b\u8425\u517b\u514d\u75ab\uff08calprotectin\u91ca\u653e\u589e\u5f3a\u3001lipocalin-2\u4ecb\u5bfc\u7684\u94c1\u8f7d\u4f53\u87af\u5408\uff09\u548c\u80c6\u6c41\u9178\u4ee3\u8c22\uff08\u7ed3\u5408\u578b\u80c6\u6c41\u9178\u5347\u9ad8\u4fc3\u8fdb\u5b62\u5b50\u840c\u53d1\uff09\u3002\u9884\u671fFE\u7ec4\u94c1\u7a33\u6001\u4ee3\u8c22\u7269\uff08\u8840\u7ea2\u7d20\u3001enterobactin\u7b49\u94c1\u8f7d\u4f53\uff09\u663e\u8457\u4e0a\u8c03\uff0c\u7ed3\u5408\u578b\u80c6\u6c41\u9178\uff08\u725b\u78fa\u80c6\u9178\u76d0TCA\uff09\u5347\u9ad8\u800c\u6291\u5236\u5b62\u5b50\u840c\u53d1\u7684\u80c6\u9178\u76d0\u964d\u4f4e\uff0c\u77ed\u94fe\u8102\u80aa\u9178\uff08\u5c24\u5176\u4e01\u9178\uff09\u663e\u8457\u964d\u4f4e\u3002\n\n**2. CD_vs_NC\uff08\u6a21\u578b\u9a8c\u8bc1\u6bd4\u5bf9\uff09**\n\n\u6b64\u6bd4\u5bf9\u5efa\u7acbCDI\u611f\u67d3\u672c\u8eab\u7684\u4ee3\u8c22\u7ec4\u7279\u5f81\u57fa\u7ebf\u3002\u6839\u636e\u77e5\u8bc6\u5e93\uff0cCDI\u611f\u67d3\u4f1a\u5f15\u8d77\u80a0\u9053\u83cc\u7fa4\u5931\u8c03\uff08\u80a0\u6746\u83cc\u79d1\u5bcc\u96c6\u3001\u4ea7SCFA\u83cc\u51cf\u5c11\uff09\u3001\u80c6\u6c41\u9178\u4ee3\u8c22\u7d0a\u4e71\uff08\u7ed3\u5408\u578b\u80c6\u6c41\u9178\u5347\u9ad8\u4fc3\u8fdb\u5b62\u5b50\u840c\u53d1\uff09\u3001\u5bbf\u4e3b\u8425\u517b\u514d\u75ab\u5e94\u7b54\uff08calprotectin\u548clipocalin-2\u4e0a\u8c03\uff09\u53ca\u708e\u75c7\u53cd\u5e94\uff08\u4e2d\u6027\u7c92\u7ec6\u80de\u6d78\u6da6\u3001TNF\u03b1/IL-1\u03b2\u91ca\u653e\uff09\u3002\u9884\u671f\u89c2\u5bdf\u5230\u80c6\u6c41\u9178\u8c31\u5178\u578b\u504f\u79fb\u3001SCFA\u6c34\u5e73\u4e0b\u964d\u3001\u708e\u75c7\u76f8\u5173\u4ee3\u8c22\u7269\u5347\u9ad8\u7b49\u611f\u67d3\u7279\u5f81\u3002\u8be5\u6bd4\u5bf9\u65e2\u662f\u6a21\u578b\u9a8c\u8bc1\u624b\u6bb5\uff0c\u4e5f\u662f\u533a\u5206\"CDI\u672c\u8eab\u6548\u5e94\"\u4e0e\"\u9ad8\u94c1\u996e\u98df\u53e0\u52a0\u6548\u5e94\"\u7684\u57fa\u51c6\u53c2\u7167\u3002\n\n**3. FE_vs_NC\uff08\u6574\u4f53\u6548\u5e94\u6bd4\u5bf9\uff09**\n\n\u8bc4\u4f30\u9ad8\u94c1\u996e\u98df\u8054\u5408CDI\u611f\u67d3\u76f8\u5bf9\u4e8e\u5065\u5eb7\u57fa\u7ebf\u7684\u7efc\u5408\u4ee3\u8c22\u6270\u52a8\u5e45\u5ea6\u3002\u4e0eCD_vs_NC\u6bd4\u8f83\uff0c\u53ef\u533a\u5206\u54ea\u4e9b\u53d8\u5316\u662fCDI\u672c\u8eab\u5f15\u8d77\uff0c\u54ea\u4e9b\u662f\u9ad8\u94c1\u996e\u98df\u7684\u53e0\u52a0/\u534f\u540c\u6548\u5e94\u3002\u9884\u671fFE_vs_NC\u7684\u6270\u52a8\u5e45\u5ea6\u5927\u4e8eCD_vs_NC\uff0c\u5c24\u5176\u5728\u94c1\u4ee3\u8c22\u7269\u3001\u80c6\u6c41\u9178\u7d0a\u4e71\u548cSCFA\u964d\u4f4e\u65b9\u9762\u66f4\u4e3a\u663e\u8457\uff0c\u5e76\u53ef\u80fd\u89c2\u5bdf\u5230\u94c1\u6bd2\u6027\u76f8\u5173\u7684\u6c27\u5316\u5e94\u6fc0\u4ee3\u8c22\u7269\uff08\u8c37\u80f1\u7518\u80bd\u4ee3\u8c22\u7269\u3001\u8102\u8d28\u8fc7\u6c27\u5316\u7269\uff09\u5347\u9ad8\u3002\n\n###\u4e09\u3001\u4e0e\u7814\u7a76\u4e3b\u9898\u7684\u6df1\u5ea6\u5173\u8054\u6027\u6bd4\u5bf9\u8bbe\u8ba1\u7cbe\u51c6\u5bf9\u5e94\u7814\u7a76\u4e3b\u9898\u4e2d\"\u996e\u98df-\u80a0\u9053\u83cc\u7fa4-\u5bbf\u4e3b\"\u4e92\u4f5c\u94fe\u6761\u7684\u6bcf\u4e2a\u73af\u8282\uff1a**\u9ad8\u94c1\u996e\u98df**\uff08FE_vs_CD\u7684\u6838\u5fc3\u53d8\u91cf\uff09\u2192 **\u80a0\u9053\u83cc\u7fa4\u5931\u8c03**\uff08\u901a\u8fc7SCFA\u3001\u80c6\u6c41\u9178\u3001\u8150\u8d25\u4ee3\u8c22\u7269\u53cd\u6620\uff09\u2192 **CDI\u6613\u611f\u6027\u6539\u53d8**\uff08\u901a\u8fc7\u94c1\u8f7d\u4f53\u3001\u6bd2\u7d20\u76f8\u5173\u4ee3\u8c22\u7269\u3001\u8425\u517b\u514d\u75ab\u6807\u5fd7\u7269\u53cd\u6620\uff09\u2192 **\u4ee3\u8c22\u7269\u4ecb\u5bfc\u673a\u5236**\uff08\u901a\u8fc7\u80c6\u6c41\u9178\u8c31\u3001\u94c1\u7a33\u6001\u4ee3\u8c22\u7269\u3001\u6c27\u5316\u5e94\u6fc0\u6807\u5fd7\u7269\u63ed\u793a\uff09\u3002\u6bd4\u5bf9\u8bbe\u8ba1\u7cfb\u7edf\u8986\u76d6\u4e86\u77e5\u8bc6\u5e93\u4e2d\u8bb0\u8f7d\u768424\u6761\u5173\u952e\u901a\u8def\u548c19\u7c7b\u5173\u952e\u4ee3\u8c22\u7269\u3002\n\n###\u56db\u3001\u8bbe\u8ba1\u5408\u7406\u6027\u8bba\u8bc1- **\u5206\u5c42\u9012\u8fdb**\uff1a\u4e09\u7ec4\u6bd4\u5bf9\u4ece\"\u6709\u65e0\u9ad8\u94c1\u996e\u98df\u7684\u5f71\u54cd\"\uff08FE_vs_CD\uff09\u5230\"\u6709\u65e0\u611f\u67d3\u7684\u5f71\u54cd\"\uff08CD_vs_NC\uff09\u518d\u5230\"\u7efc\u5408\u6548\u5e94\"\uff08FE_vs_NC\uff09\uff0c\u5f62\u6210\u5b8c\u6574\u7684\u903b\u8f91\u95ed\u73af\u3002\n- **\u7edf\u8ba1\u6548\u529b\u5145\u5206**\uff1a\u6bcf\u7ec4\u5747\u67096\u4e2a\u72ec\u7acb\u751f\u7269\u5b66\u91cd\u590d\uff0c\u6ee1\u8db3LIMMA\u5206\u6790\u8981\u6c42\u3002\n- **\u5206\u7ec4\u547d\u540d\u7cbe\u51c6\u5bf9\u5e94\u6837\u672c\u4fe1\u606f\u8868**\uff0c\u786e\u4fdd\u4e86\u540e\u7eed\u6a21\u5757\u53ef\u76f4\u63a5\u8c03\u7528\uff0c\u65e0\u9700\u989d\u5916\u6570\u636e\u6e05\u6d17\u3002\n- **\u6a2a\u622a\u9762\u8bbe\u8ba1\u4e0e\u672c\u6a21\u5757\u5339\u914d**\uff1a\u6570\u636e\u96c6\u4e3a\u5355\u4e00\u65f6\u95f4\u70b9\u91c7\u6837\uff0c\u65e0\u9700\u65f6\u95f4\u5e8f\u5217\u6bd4\u5bf9\u3002","comparisons": [{"name": "FE_vs_CD","treatment": "high iron diet before","control": "Clostridium difficile infection","biological_rationale": "\u3010\u6838\u5fc3\u6bd4\u5bf9\u3011FE\u7ec4\u4e0eCD\u7ec4\u5747\u611f\u67d3\u4e86\u8270\u96be\u68ad\u83cc\uff0c\u552f\u4e00\u533a\u522b\u5728\u4e8eFE\u7ec4\u5728\u611f\u67d3\u524d\u63a5\u53d7\u4e86\u9ad8\u94c1\u996e\u98df\uff08400 mg/kg\u786b\u9178\u4e9a\u94c1\uff09\u5e72\u9884\u3002\u6b64\u6bd4\u5bf9\u53ef\u76f4\u63a5\u63ed\u793a\u9ad8\u94c1\u996e\u98df\u5bf9CDI\u611f\u