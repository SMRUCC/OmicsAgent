6\u95f4\u70b9\uff09\uff0c\u65e0\u65f6\u95f4\u6ede\u540e\u4fe1\u606f\uff0c\u4f20\u7edf\u52a8\u6001\u8d1d\u53f6\u65af\u7f51\u7edc\uff08\u9700\u22652\u4e2a\u65f6\u95f4\u70b9\u5efa\u6a21t-1\u2192t\u56e0\u679c\uff09\u4e0d\u53ef\u7528\u3002\u5df2\u9002\u5e94\u6027\u8c03\u6574\u4e3a\u6a21\u5757\u7ea7\u975e\u52a8\u6001\u8d1d\u53f6\u65af\u7f51\u7edc\uff0c\u63a8\u65ad\u7684\u662f\u540c\u671f\u5171\u53d8/\u8c03\u63a7\u5173\u7cfb\u800c\u975e\u65f6\u95f4\u56e0\u679c\uff0c\u89e3\u91ca\u7ed3\u679c\u65f6\u9700\u6ce8\u610f'\u76f8\u5173\u6027\u4e0d\u7b49\u4e8e\u56e0\u679c\u6027'\u3002\n2.\u3010\u7edf\u8ba1\u6548\u529b\u5c40\u9650\u30116\u8282\u70b9\u00d718\u6837\u672c\uff08\u6837\u672c/\u8282\u70b9\u6bd4=3\uff09\uff0c\u5bf9\u8d1d\u53f6\u65af\u7f51\u7edc\u7ed3\u6784\u5b66\u4e60\u5c5e\u4e8e\u8f83\u4f4e\u6c34\u5e73\u3002\u5fc5\u987b\u4f7f\u7528bootstrap200\u6b21\u8bc4\u4f30\u8fb9\u7a33\u5b9a\u6027\uff0c\u4ec5\u4fdd\u7559\u9ad8\u7f6e\u4fe1\u5ea6\u8fb9\uff08\u226570%\uff09\uff0c\u5e76\u7ed3\u5408WGCNA\u7ebf\u6027\u56de\u5f52\u7ed3\u679c\uff08\u5404\u6a21\u5757R\u00b2\u5747>0.81\uff09\u8fdb\u884c\u4ea4\u53c9\u9a8c\u8bc1\u3002\n3.\u3010\u4e0e\u4e0a\u6e38\u6a21\u5757\u8854\u63a5\u3011WGCNA\uff08\u6a21\u57576\uff09\u5df2\u63d0\u4f9b\u6a21\u5757\u4e0e\u5206\u7ec4\u6027\u72b6\u7684Pearson\u76f8\u5173\u6027\uff08\u5982Turquoise-FE: r=0.971, p=2.3e-11\uff09\uff1bCMeans\uff08\u6a21\u57577\uff09\u5df2\u786e\u8ba4Cluster1\u2192Turquoise\u4e3a100%\u5339\u914d\u3002\u672c\u6a21\u5757\u5728\u6b64\u57fa\u7840\u4e0a\u63ed\u793a\u6a21\u5757\u95f4\u6709\u5411\u8c03\u63a7\u5173\u7cfb\uff0c\u6784\u6210'\u4ee3\u8c22\u7269\uff08~2059\u4e2a\uff09\u2192\u5171\u8868\u8fbe\u6a21\u5757\uff086\u4e2a\uff09\u2192\u6a21\u5757\u95f4\u8c03\u63a7\u7f51\u7edc'\u7684\u4e09\u7ea7\u5206\u6790\u4f53\u7cfb\u3002\n4.\u3010\u56de\u9000\u65b9\u6848\u3011\u82e5\u8d1d\u53f6\u65af\u7f51\u7edc\u56e0\u8282\u70b9\u6570\u5c11\u5bfc\u81f4\u8fb9\u7a00\u758f\uff0c\u8865\u5145PLS-PM\u5206\u6790\uff08\u4f7f\u7528network.R\u4e2d\u7684perform_plspm\u51fd\u6570\uff09\uff0c\u4ee5KEGG22\u4e2a\u901a\u8def\u7c7b\u522b\u4f5c\u4e3a\u6f5c\u53d8\u91cf\u6784\u5efa\u8def\u5f84\u6a21\u578b\uff0c\u63d0\u4f9b\u4e92\u8865\u89c6\u89d2\u3002\n5.\u3010\u7ed8\u56fe\u89c4\u8303\u3011\u6240\u6709\u6807\u7b7e\u4f7f\u7528\u82f1\u6587\uff1b\u540c\u65f6\u8f93\u51faPDF\uff08\u53ef\u7f16\u8f91\u77e2\u91cf\uff09\u548cPNG\uff08300dpi\uff09\uff1b\u8282\u70b9\u6807\u6ce8\u683c\u5f0f'\u6a21\u5757\u540d[\u5173\u8054\u5206\u7ec4/\u5173\u952e\u901a\u8def]'\uff08\u5982Turquoise[FE\u2191/Signal\u2193]\uff09\u3002",/* 阶段性总结文本 */"conclusion": "##\u6a21\u5757\u516b\uff1a\u52a8\u6001\u8d1d\u53f6\u65af\u7f51\u7edc\u5206\u6790 \u2014\u9636\u6bb5\u6027\u603b\u7ed3###\u4e00\u3001\u65b9\u6cd5\u9002\u5e94\u6027\u8c03\u6574\u4e0e\u80cc\u666f\u8bf4\u660e\u672c\u6a21\u5757\u539f\u8ba1\u5212\u91c7\u7528\u52a8\u6001\u8d1d\u53f6\u65af\u7f51\u7edc\uff08Dynamic Bayesian Network, DBN\uff09\u5bf9\u65f6\u95f4\u5e8f\u5217\u6570\u636e\u8fdb\u884c\u8c03\u63a7\u5173\u7cfb\u63a8\u65ad\uff0c\u4f46\u7531\u4e8e\u672c\u4ee3\u8c22\u7ec4\u5b66\u6570\u636e\u96c6\u4e3a**\u6a2a\u622a\u9762\u8bbe\u8ba1**\uff08\u4ec5\u5355\u4e00\u65f6\u95f4\u70b9\u91c7\u6837\uff0c18\u4e2a\u6837\u672c\u6765\u81eaNC\u3001CD\u3001FE\u4e09\u4e2a\u5206\u7ec4\uff09\uff0c\u6837\u672c\u4fe1\u606f\u8868\u4e2d\u4e0d\u5305\u542b\u65f6\u95f4\u4fe1\u606f\u5217\uff0c\u4f20\u7edfDBN\u6240\u9700\u7684\u65f6\u95f4\u6ede\u540e\u56e0\u679c\u5173\u7cfb\u5efa\u6a21\uff08t-1\u2192t\uff09\u65e0\u6cd5\u5b9e\u73b0\u3002\u56e0\u6b64\uff0c\u672c\u6a21\u5757\u9002\u5e94\u6027\u8c03\u6574\u4e3a**\u6a21\u5757\u7ea7\u8d1d\u53f6\u65af\u7f51\u7edc\u5206\u6790**\uff1a\u5229\u7528\u4e0a\u6e38WGCNA\u6a21\u5757\uff08\u6a21\u57576\uff09\u8bc6\u522b\u76846\u4e2a\u4ee3\u8c22\u7269\u5171\u8868\u8fbe\u6a21\u5757\u7684\u7279\u5f81\u57fa\u56e0\uff08Module Eigengene, ME\uff09\u4f5c\u4e3a\u9ad8\u9636\u7f51\u7edc\u8282\u70b9\uff0c\u4f7f\u7528bnlearn\u5305\u7684Hill-Climbing\u7b97\u6cd5\uff08hc\uff09\uff0c\u7ed3\u5408BIC\u8bc4\u5206\u51fd\u6570\u548c200\u6b21bootstrap\u91cd\u91c7\u6837\u8fdb\u884c\u7ed3\u6784\u5b66\u4e60\uff0c\u5e76\u5728\u22650.7\u7f6e\u4fe1\u5ea6\u9608\u503c\u4e0b\u7b5b\u9009\u53ef\u9760\u7684\u6709\u5411\u8c03\u63a7\u8fb9\u3002\u8fd9\u4e00\u7b56\u7565\u6784\u6210\u4e86\"\u4ee3\u8c22\u7269\uff08~2,059\u4e2a\uff09\u2192\u5171\u8868\u8fbe\u6a21\u5757\uff086\u4e2a\uff09\u2192\u6a21\u5757\u95f4\u8c03\u63a7\u7f51\u7edc\"\u4e09\u7ea7\u5206\u6790\u4f53\u7cfb\u7684\u6700\u9876\u5c42\u3002\n\n###\u4e8c\u3001\u6a21\u5757\u95f4\u8c03\u63a7\u7f51\u7edc\u62d3\u6251\u7279\u5f81\u8d1d\u53f6\u65af\u7f51\u7edc\u57286\u4e2a\u6a21\u5757\u7279\u5f81\u57fa\u56e0\u4e4b\u95f4\u8bc6\u522b\u51fa**6\u6761\u9ad8\u7f6e\u4fe1\u5ea6\u6709\u5411\u8c03\u63a7\u8fb9**\uff08\u7f6e\u4fe1\u5ea6\u22650.7\uff09\uff0c\u7f51\u7edc\u62d3\u6251\u5448\u73b0\u6e05\u6670\u7684\u5c42\u7ea7\u8c03\u63a7\u7ed3\u6784\uff1a\n\n**\uff081\uff09Turquoise\uff08\u9ad8\u94c1\u996e\u98df\u6807\u5fd7\u6a21\u5757\uff09\u2192 Blue\uff08\u5065\u5eb7\u6807\u5fd7\u6a21\u5757\uff09\uff0c\u7f6e\u4fe1\u5ea60.985**\uff1a\u8fd9\u662f\u6574\u4e2a\u7f51\u7edc\u4e2d\u7f6e\u4fe1\u5ea6\u6700\u9ad8\u7684\u8c03\u63a7\u5173\u7cfb\u3002Turquoise\u6a21\u5757\u4e0eFE\u7ec4\u5448\u6781\u5f3a\u6b63\u76f8\u5173\uff08r=0.971\uff09\uff0cBlue\u6a21\u5757\u4e0eNC\u7ec4\u5448\u6781\u5f3a\u6b63\u76f8\u5173\uff08r=0.919\uff09\uff0c\u8be5\u6709\u5411\u8fb9\u8868\u660e\u9ad8\u94c1\u996e\u98df\u5e72\u9884\u8bf1\u5bfc\u7684\u4ee3\u8c22\u91cd\u7f16\u7a0b\u5bf9\u5065\u5eb7\u57fa\u7ebf\u4ee3\u8c22\u72b6\u6001\u5177\u6709\u5f3a\u70c8\u7684\u6291\u5236\u6027\u8c03\u63a7\u4f5c\u7528\u3002\n\n**\uff082\uff09Turquoise\uff08\u9ad8\u94c1\u996e\u98df\u6807\u5fd7\u6a21\u5757\uff09\u2192 Red\uff08\u514d\u75ab\u4fe1\u53f7\u6a21\u5757\uff09\uff0c\u7f6e\u4fe1\u5ea60.870**\uff1aRed\u6a21\u5757\u4e0e\u4fe1\u53f7\u8f6c\u5bfc\u901a\u8def\u6d3b\u6027\u5448\u6781\u5f3a\u6b63\u76f8\u5173\uff08r=0.978\uff09\uff0c\u800c\u4e0eFE\u7ec4\u6781\u5f3a\u8d1f\u76f8\u5173\uff08r=-0.913\uff09\u3002\u6b64\u6709\u5411\u8fb9\u76f4\u63a5\u9a8c\u8bc1\u4e86\u77e5\u8bc6\u5e93\u4e2d\"\u9ad8\u94c1\u996e\u98df\u6291\u5236\u5bbf\u4e3b\u514d\u75ab\u4fe1\u53f7\u4f20\u9012\"\u7684\u6838\u5fc3\u5047\u8bf4\uff0c\u4e14\u4e0eGSVA\u5206\u6790\u4e2d\"\u4fe1\u53f7\u8f6c\u5bfc\u901a\u8def\u5728FE\u7ec4\u4e2d\u5927\u5e45\u4e0b\u8c03\uff08logFC=-0.96\uff09\"\u7684\u53d1\u73b0\u9ad8\u5ea6\u4e00\u81f4\u3002\n\n**\uff083\uff09Magenta\uff08CDI\u611f\u67d3\u6807\u5fd7\u6a21\u5757\uff09\u2192 Blue\uff08\u5065\u5eb7\u6807\u5fd7\u6a21\u5757\uff09\uff0c\u7f6e\u4fe1\u5ea60.725**\uff1aMagenta\u6a21\u5757\u4e0eCD\u7ec4\u6781\u5f3a\u6b63\u76f8\u5173\uff08r=0.892\uff09\uff0c\u6b64\u8fb9\u8868\u660e\u8270\u96be\u68ad\u83cc\u611f\u67d3\u672c\u8eab\u7684\u4ee3\u8c22\u7279\u5f81\u5bf9\u5065\u5eb7\u80a0\u9053\u4ee3\u8c22\u5177\u6709\u6291\u5236\u6548\u5e94\u3002\n\n**\uff084\uff09Magenta\uff08CDI\u611f\u67d3\u6807\u5fd7\u6a21\u5757\uff09\u2192 Red\uff08\u514d\u75ab\u4fe1\u53f7\u6a21\u5757\uff09\uff0c\u7f6e\u4fe1\u5ea60.780**\uff1a\u63d0\u793aCDI\u611f\u67d3\u53ef\u6fc0\u6d3b\u5bbf\u4e3b\u514d\u75ab\u4fe1\u53f7\u5e94\u7b54\uff0c\u4e0e\u611f\u67d3\u6a21\u578b\u9884\u671f\u4e00\u81f4\u3002\n\n**\uff085\uff09Blue\uff08\u5065\u5eb7\u6807\u5fd7\u6a21\u5757\uff09\u2192 Red\uff08\u514d\u75ab\u4fe1\u53f7\u6a21\u5757\uff09\uff0c\u7f6e\u4fe1\u5ea60.735**\uff1a\u8868\u660e\u5065\u5eb7\u57fa\u7ebf\u4ee3\u8c22\u72b6\u6001\u5bf9\u514d\u75ab\u4fe1\u53f7\u901a\u8def\u5177\u6709\u6b63\u5411\u652f\u6301\u4f5c\u7528\uff0c\u8fd9\u4e00\u8c03\u63a7\u5173\u7cfb\u5728\u611f\u67d3\u548c\u996e\u98df\u5e72\u9884\u540e\u663e\u8457\u524a\u5f31\u3002\n\n**\uff086\uff09Black\uff08\u57fa\u7840\u4ee3\u8c22\u6a21\u5757\uff09\u2192 Purple\uff08\u6b21\u8981\u6a21\u5757\uff09\uff0c\u7f6e\u4fe1\u5ea60.795**\uff1a\u53cd\u6620\u57fa\u7840\u4ee3\u8c22\u529f\u80fd\u5bf9\u6b21\u8981\u6a21\u5757\u7684\u9a71\u52a8\u5173\u7cfb\u3002\n\n\u6b64\u5916\uff0c\u6a21\u5757\u95f4Pearson\u76f8\u5173\u77e9\u9635\u663e\u793a\uff1aTurquoise\u4e0eRed\u5448\u6781\u5f3a\u8d1f\u76f8\u5173\uff08r=-0.944\uff09\uff0cTurquoise\u4e0eBlue\u5448\u5f3a\u8d1f\u76f8\u5173\uff08r=-0.808\uff09\uff0cRed\u4e0eMagenta\u5448\u4e2d\u7b49\u6b63\u76f8\u5173\uff08r=0.614\uff09\uff0c\u8fd9\u4e9b\u76f8\u5173\u6027\u6a21\u5f0f\u4e0e\u8d1d\u53f6\u65af\u7f51\u7edc\u5b66\u4e60\u51fa\u7684\u6709\u5411\u8fb9\u65b9\u5411\u9ad8\u5ea6\u4e00\u81f4\u3002\n\n###\u4e09\u3001\u7ed3\u679c\u5bf9\u7814\u7a76\u4e3b\u9898\u7684\u652f\u6301\u4e0e\u751f\u7269\u5b66\u673a\u5236\u5173\u8054\u672c\u5206\u6790\u7ed3\u679c\u76f4\u63a5\u652f\u6491\u4e86\"**\u9ad8\u94c1\u996e\u98df\u2192\u80a0\u9053\u83cc\u7fa4\u5931\u8c03\u2192CDI\u6613\u611f\u6027\u6539\u53d8\u2192\u4ee3\u8c22\u7269\u4ecb\u5bfc**\"\u7684\u7814\u7a76\u94fe\u6761\u3002\u5728\u4ee3\u8c22\u7f51\u7edc\u8fc1\u79fb\u8f68\u8ff9\u7684\u89c6\u89d2\u4e0b\uff0c\u4e09\u7ec4\u7684\u5206\u7ec4\u5747\u503c\u7279\u5f81\u57fa\u56e0\u6a21\u5f0f\u6e05\u6670\u5c55\u793a\u4e86\u4ece\"NC\u7ec4\uff08Blue\u9ad8\u8868\u8fbe+0.306\uff09\u2192 CD\u7ec4\uff08Magenta\u9ad8\u8868\u8fbe+0.297\uff0cRed\u9ad8\u8868\u8fbe+0.199\uff09\u2192 FE\u7ec4\uff08Turquoise\u9ad8\u8868\u8fbe+0.324\uff0cBlue\u4f4e\u8868\u8fbe-0.248\uff0cRed\u4f4e\u8868\u8fbe-0.304\uff09\"\u7684\u5b8c\u6574\u8f6c\u53d8\u3002\u8d1d\u53f6\u65af\u7f51\u7edc\u8fdb\u4e00\u6b65\u63ed\u793a\u4e86**\u4e09\u4e2a\u6838\u5fc3\u8c03\u63a7\u8f74**\uff1a\uff081\uff09**Turquoise[FE\u2191] \u2192 Red[\u4fe1\u53f7\u8f6c\u5bfc\u2191]**\u7684\u6291\u5236\u6027\u8c03\u63a7\uff0c\u4e3a\"\u9ad8\u94c1\u996e\u98df\u901a\u8fc7\u6291\u5236\u80a0\u9053\u4e2d\u6027\u7c92\u7ec6\u80de\u62db\u52df\u5f71\u54cdCDI\u7ed3\u5c40\"\u63d0\u4f9b\u4e86\u7f51\u7edc\u7ea7\u5206\u5b50\u8bc1\u636e\uff1b\uff082\uff09**Magenta[CD\u2191] \u2192 Blue[NC\u2191]**\u7684\u4e92\u65a5\u8c03\u63a7\uff0c\u9a8c\u8bc1\u4e86CDI\u611f\u67d3\u5bf9\u5065\u5eb7\u80a0\u9053\u4ee3\u8c22\u7684\u7834\u574f\u4f5c\u7528\uff1b\uff083\uff09**Black[\u57fa\u7840\u4ee3\u8c22] \u2192 Purple[\u6b21\u8981\u6a21\u5757]**\u7684\u57fa\u7840\u9a71\u52a8\u5173