9\u6570\u91cf\u3001ANOVA\u663e\u8457\u4ee3\u8c22\u7269\u6bd4\u4f8b\u3002\u751f\u6210Markdown\u683c\u5f0f\u7684\u9636\u6bb5\u6027\u603b\u7ed3\u6587\u4ef6\uff08module_summary.md\uff09\uff0c\u5305\u542b\u6570\u636e\u8d28\u91cf\u8bc4\u4f30\u7ed3\u8bba\u3001\u6837\u672c\u5206\u7ec4\u5206\u79bb\u662f\u5426\u663e\u8457\u3001\u662f\u5426\u5b58\u5728\u79bb\u7fa4\u6837\u672c\u3001\u5bf9\u4e0b\u6e38LIMMA\u5dee\u5f02\u5206\u6790\u7684\u53c2\u8003\u5efa\u8bae\u3002","goal": "\u901a\u8fc7\u7edf\u8ba1\u68c0\u9a8c\u4ece\u5355\u53d8\u91cf\u89d2\u5ea6\u5168\u9762\u8bc4\u4f30\u4ee3\u8c22\u7269\u6574\u4f53\u5dee\u5f02\u663e\u8457\u6027\uff0c\u4e3a\u540e\u7eedLIMMA\u5dee\u5f02\u5206\u6790\u63d0\u4f9b\u4ee3\u8c22\u7269\u7b5b\u9009\u7684\u7edf\u8ba1\u57fa\u7ebf\u3002\u6574\u5408\u964d\u7ef4\u5206\u6790\u548c\u7edf\u8ba1\u68c0\u9a8c\u7ed3\u679c\u5f62\u6210\u6570\u636e\u8d28\u91cf\u8bc4\u4f30\u62a5\u544a\uff0c\u786e\u4fdd\u4e0b\u6e38\u5206\u6790\u6a21\u5757\u548c\u6700\u7ec8\u62a5\u544a\u57fa\u4e8e\u53ef\u9760\u7684\u6570\u636e\u8d28\u91cf\u4fe1\u606f\u5f00\u5c55\u5de5\u4f5c\u3002","rscript_path": null}],"notes": "1.\u3010QC\u6837\u672c\u5904\u7406\u3011\u6837\u672c\u4fe1\u606f\u8868\u4e2d\u5305\u542b3\u4e2aQC\u6837\u672c\uff08Fc16YH_QC01~QC03\uff09\uff0c\u4f46\u8868\u8fbe\u77e9\u9635\uff08preprocessed_expression.csv\uff09\u4e2d\u65e0\u5bf9\u5e94\u5217\uff0c\u9700\u5728\u8bfb\u53d6\u6837\u672c\u4fe1\u606f\u8868\u540e\u4ec5\u4fdd\u7559\u4e0e\u8868\u8fbe\u77e9\u9635\u5217\u540d\u5339\u914d\u7684\u6837\u672c\uff0cQC\u6837\u672c\u81ea\u52a8\u6392\u9664\uff0c\u4e0d\u53c2\u4e0e\u4efb\u4f55\u5206\u6790\u3002\n2.\u3010\u7ec4\u6807\u7b7e\u6807\u51c6\u5316\u3011\u539f\u59cbsample_info\u9700\u6620\u5c04\u4e3a\u7b80\u6d01\u82f1\u6587\u6807\u7b7e\uff1aCD\uff08Clostridium difficile infection\uff09\u3001FE\uff08high iron diet before\uff09\u3001NC\uff08Standard control\uff09\u3002\u56fe\u5f62\u56fe\u4f8b\u4e2d\u540c\u65f6\u663e\u793a\u7f29\u5199\u548c\u5168\u79f0\uff08\u5982 'NC (Healthy Control)'\uff09\u3002\n3.\u3010R\u5305\u4f9d\u8d56\u4e0e\u81ea\u52a8\u5b89\u88c5\u3011\u9700\u5b89\u88c5\u7684\u5305\uff1aggplot2\u3001ggrepel\u3001RColorBrewer\u3001viridis\uff08CRAN\uff09\uff0cmixOmics\u3001ropls\uff08Bioconductor\uff09\u3002\u6240\u6709\u5305\u5728\u811a\u672c\u542f\u52a8\u65f6\u81ea\u52a8\u68c0\u6d4b\u5e76\u5b89\u88c5\uff0cBiocManager\u4f5c\u4e3a\u524d\u7f6e\u4f9d\u8d56\u3002\n4.\u3010\u52a0\u6743\u6b27\u6c0f\u8ddd\u79bb\u516c\u5f0f\u3011\u6743\u91cd w_i = var_i / sum(var_1..var_k)\uff0c\u5176\u4e2d k=3(PCA)\u62162(PLSDA)\u3002\u8ddd\u79bb = sqrt(sum(w_i \u00d7 (score_i \u2212 centroid_i)^2))\u3002\n5.\u3010\u7f6e\u6362\u68c0\u9a8c\u8bbe\u8ba1\u3011n=1000\u6b21\uff0c\u4ee5\u89c2\u6d4b\u7684\u7ec4\u5185\u8ddd\u79bb\u5747\u503c/\u7ec4\u95f4\u8ddd\u79bb\u5747\u503c\u6bd4\u7387\u4f5c\u4e3a\u68c0\u9a8c\u7edf\u8ba1\u91cf\u3002\u82e5\u89c2\u6d4b\u6bd4\u7387\u663e\u8457\u5c0f\u4e8e\u7f6e\u6362\u5206\u5e03\uff08p<0.05\uff09\uff0c\u8bf4\u660e\u7ec4\u5185\u6837\u672c\u6bd4\u968f\u673a\u5206\u7ec4\u66f4\u7d27\u805a\uff0c\u5206\u7ec4\u5177\u6709\u663e\u8457\u751f\u7269\u5b66\u610f\u4e49\u3002\n6.\u3010\u56fe\u5f62\u8f93\u51fa\u89c4\u8303\u3011\u6240\u6709ggplot2\u56fe\u5f62\u4f7f\u7528\u82f1\u6587\u6807\u7b7e\uff0c\u914d\u8272\u65b9\u6848\u56fa\u5b9a\uff1aNC=#4DBBD5\uff08\u84dd\u8272\uff09\u3001CD=#E64B35\uff08\u7ea2\u8272\uff09\u3001FE=#00A087\uff08\u7eff\u8272\uff09\u3002\u540c\u65f6\u4fdd\u5b58PNG\uff08300dpi\uff09\u548cPDF\u4e24\u79cd\u683c\u5f0f\uff0c\u5c3a\u5bf8\u7edf\u4e00\u4e3a9\u00d77\u82f1\u5bf8\uff08PCA/PLSDA\uff09\u548c8\u00d76\u82f1\u5bf8\uff08OPLSDA\u6210\u5bf9\u56fe\uff09\u3002\n7.\u3010OPLSDA\u7279\u6b8a\u8bf4\u660e\u3011ropls::opls\u4ec5\u652f\u6301\u4e8c\u5143\u5206\u7c7b\uff0c\u56e0\u6b64\u4e09\u7ec4\u5206\u6790\u9700\u8fdb\u884c\u4e09\u6b21\u6210\u5bf9\u6bd4\u8f83\uff08FE_vs_NC\u3001CD_vs_NC\u3001FE_vs_CD\uff09\uff0c\u6240\u6709\u6837\u672c\u7684\u6c47\u603b\u8ddd\u79bb\u548c\u7f6e\u6362\u68c0\u9a8c\u6309\u6210\u5bf9\u5206\u522b\u8ba1\u7b97\u3002OPLSDA\u7684VIP\u548cS-plot\u4ec5\u4ece\u9884\u6d4b\u6210\u5206\uff08p1\uff09\u63d0\u53d6\u3002\n8.\u3010\u5df2\u6709\u811a\u672c\u590d\u7528\u3011scripts/\u76ee\u5f55\u4e0b\u5df2\u5b58\u5728pca_analysis.R\u548cplsda_oplsda_analysis.R\u811a\u672c\u6846\u67b6\uff0c\u53ef\u76f4\u63a5\u5728\u8fd9\u4e9b\u811a\u672c\u57fa\u7840\u4e0a\u6267\u884c\u5206\u6790\uff0c\u4f46\u9700\u6ce8\u610f\uff1a\u73b0\u6709\u811a\u672c\u7684FIGURE_DIR\u6307\u5411analysis/2_pca_plsda_oplsda_analysis/figures/\uff0c\u9700\u786e\u4fdd\u8be5\u76ee\u5f55\u521b\u5efa\u6210\u529f\u3002\n9.\u3010\u6570\u636e\u5b8c\u6574\u6027\u3011\u8868\u8fbe\u77e9\u9635\u4e3a2059\u4ee3\u8c22\u7269\u00d718\u6837\u672c\uff08CD=6, FE=6, NC=6\uff09\uff0c\u65e0\u7f3a\u5931\u503c\uff0c\u6570\u636e\u5b8c\u6574\u6027\u826f\u597d\uff0c\u9002\u5408\u8fdb\u884cPCA/PLSDA/OPLSDA\u5206\u6790\u3002\n10.\u3010\u5206\u6790\u987a\u5e8f\u4f9d\u8d56\u3011Step1\uff08PCA\uff09\u72ec\u7acb\u8fd0\u884c\uff0cStep2\uff08PLSDA/OPLSDA\uff09\u4e5f\u72ec\u7acb\u4e8eStep1\uff0cStep3\uff08F\u68c0\u9a8c/ANOVA/\u603b\u7ed3\uff09\u4f9d\u8d56\u524d\u4e24\u6b65\u7684\u8f93\u51fa\u7ed3\u679c\u3002\u4e09\u4e2a\u6b65\u9aa4\u53ef\u6309\u987a\u5e8f\u4f9d\u6b21\u6267\u884c\u3002",/* 阶段性总结文本 */"conclusion": "\u73b0\u5728\u6211\u6709\u4e86\u6240\u6709\u8be6\u7ec6\u7684\u6570\u503c\u6570\u636e\uff0c\u53ef\u4ee5\u64b0\u5199\u51c6\u786e\u7684\u9636\u6bb5\u6027\u603b\u7ed3\u4e86\u3002\n\n---\n\n# PCA/PLSDA/OPLSDA\u5206\u6790\u9636\u6bb5\u6027\u603b\u7ed3##\u4e00\u3001\u5206\u6790\u6982\u8ff0\u672c\u6a21\u5757\u5bf9**2059\u4e2a\u4ee3\u8c22\u7269 \u00d718\u4e2a\u6837\u672c**\uff08NC=6\u5065\u5eb7\u5bf9\u7167, CD=6\u8270\u96be\u68ad\u83cc\u611f\u67d3, FE=6\u9ad8\u94c1\u996e\u98df+CDI\uff09\u7684\u9884\u5904\u7406\u8868\u8fbe\u77e9\u9635\u6267\u884c\u4e86\u65e0\u76d1\u7763 PCA\u3001\u6709\u76d1\u7763 PLSDA\u3001OPLSDA\u964d\u7ef4\u5206\u6790\uff0c\u4ee5\u53ca\u5355\u56e0\u7d20\u548c\u591a\u56e0\u7d20 ANOVA\u7edf\u8ba1\u68c0\u9a8c\u3002\u6240\u6709\u6a21\u578b\u5747\u901a\u8fc