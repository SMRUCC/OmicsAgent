\u7c7b\u7ed3\u6784\uff1a\u6837\u672c\u6309NC \u2192 CD \u2192 FE\u5206\u7ec4\u987a\u5e8f\u81ea\u7136\u5206\u79bb\uff0c\u7ec4\u5185\u4e00\u81f4\u6027\u826f\u597d\uff0c\u7ec4\u95f4\u5dee\u5f02\u663e\u8457\u3002NC\u7ec4\u6837\u672c\u5728\"\u8102\u8d28\u4ee3\u8c22\"\u548c\"\u8f85\u52a9\u56e0\u5b50\u548c\u7ef4\u751f\u7d20\u4ee3\u8c22\"\u901a\u8def\u4e2d\u805a\u96c6\u9ad8\u6d3b\u6027\uff0c\u800cFE\u7ec4\u5728\"\u80fd\u91cf\u4ee3\u8c22\"\u548c\"\u6392\u6cc4\u7cfb\u7edf\"\u901a\u8def\u4e2d\u7279\u5f02\u6027\u9ad8\u6d3b\u6027\u3002CD\u7ec4\u5219\u5448\u73b0\u4e2d\u95f4\u72b6\u6001\u3002\u5404KEGG\u5927\u7c7b\u5185\u7684\u901a\u8def\u5c42\u6b21\u805a\u7c7b\u6811\u663e\u793a\u4e86\u901a\u8def\u95f4\u7684\u534f\u540c\u8c03\u63a7\u5173\u7cfb\uff0c\u4f8b\u5982\u4ee3\u8c22\u7c7b\u901a\u8def\u4e2d\"\u8102\u8d28\u4ee3\u8c22\"\u4e0e\"\u80fd\u91cf\u4ee3\u8c22\"\u805a\u4e3a\u529f\u80fd\u76f8\u5173\u7684\u4e9a\u7c07\u3002\n\n---\n\n###\u4e94\u3001\u4e0e\u7814\u7a76\u4e3b\u9898\u7684\u5173\u8054\u6027\u672c\u6a21\u5757\u7684\u901a\u8def\u5206\u6790\u4ece\u4e24\u4e2a\u4e92\u8865\u5c42\u9762\u652f\u6301\u4e86\"\u9ad8\u94c1\u996e\u98df\u2192\u80a0\u9053\u83cc\u7fa4\u5931\u8c03\u2192CDI\u6613\u611f\u6027\u6539\u53d8\"\u7684\u7814\u7a76\u94fe\u6761\uff1a**\uff081\uff09**\u901a\u8def\u5bcc\u96c6\u5206\u6790\u4ece\u4ee3\u8c22\u7269\u8ba1\u6570\u89d2\u5ea6\u63d0\u793a\u6b21\u7ea7\u4ee3\u8c22\u7269\u751f\u7269\u5408\u6210\u548c\u8102\u8d28\u4ee3\u8c22\u901a\u8def\u5728\u9ad8\u94c1\u996e\u98df\u5f71\u54cd\u4e0b\u7684\u53d8\u5316\u8d8b\u52bf\uff1b**\uff082\uff09**GSVA\u5206\u6790\u4ece\u901a\u8def\u6d3b\u6027\u5c42\u9762\u63ed\u793a\u4e86\u4fe1\u53f7\u8f6c\u5bfc\u548c\u6392\u6cc4\u7cfb\u7edf\u7b49\u5bbf\u4e3b\u514d\u75ab\u76f8\u5173\u901a\u8def\u5728\u9ad8\u94c1\u996e\u98df\u5e72\u9884\u4e0b\u7684\u663e\u8457\u6d3b\u6027\u6539\u53d8\u3002\u7279\u522b\u662f\u4fe1\u53f7\u8f6c\u5bfc\u901a\u8def\u7684\u663e\u8457\u4e0b\u8c03\uff08FE\u7ec4 vs CD\u7ec4\uff09\uff0c\u4e3a\u7814\u7a76\u4e3b\u9898\u4e2d\"\u9