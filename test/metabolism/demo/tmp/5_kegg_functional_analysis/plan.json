3\u6790\u4e09\u7ec4\u6bd4\u5bf9\uff08FE_vs_CD\u3001CD_vs_NC\u3001FE_vs_NC\uff09\u7684\u663e\u8457\u6027\u5dee\u5f02\u4ee3\u8c22\u7269\u5217\u8868\uff08p.adj <0.05 & VIP >1\uff09\u3002\u4ecesampleinfo\u6216comparison_design.csv\u4e2d\u63d0\u53d6\u5206\u7ec4\u4fe1\u606f\u3002\",\n \"goal\": \"\u5b8c\u6210\u6570\u636e\u51c6\u5907\uff1a\u6784\u5efa\u5b8c\u6574\u7684KEGG\u901a\u8def-\u4ee3\u8c22\u7269\u80cc\u666f\u6620\u5c04\u8868\uff08\u7528\u4e8e\u5bcc\u96c6\u5206\u6790\uff09\u548cGSVA\u6240\u9700\u7684\u57fa\u56e0\u96c6\u5217\u8868\uff1b\u89e3\u6790\u4e09\u7ec4\u5dee\u5f02\u4ee3\u8c22\u7269\u4f5c\u4e3a\u540e\u7eed\u5bcc\u96c6\u5206\u6790\u7684\u524d\u666f\u96c6\"\n },\n {\n \"action\": \"\u6b65\u9aa42\u2014\u2014KEGG\u901a\u8def\u5bcc\u96c6\u5206\u6790\u4e0e\u53ef\u89c6\u5316\uff1a\u5bf9\u6bcf\u4e2a\u6bd4\u5bf9\u7ec4\uff08FE_vs_CD\u3001CD_vs_NC\u3001FE_vs_NC\uff09\uff0c\u4ee5\u5176\u5dee\u5f02\u4ee3\u8c22\u7269\u4e3a\u524d\u666f\u96c6\uff0c\u5168\u90e82059\u4e2a\u4ee3\u8c22\u7269\u4e3a\u80cc\u666f\u96c6\uff0c\u4f7f\u7528Fisher\u7cbe\u786e\u68c0\u9a8c\uff08\u8d85\u51e0\u4f55\u5206\u5e03\uff09\u5bf9\u6bcf\u4e2aKEGG\u901a\u8def\u8fdb\u884c\u5bcc\u96c6\u5206\u6790\uff08\u8c03\u7528enrichment.R\u4e2d\u7684perform_fisher_enrichment\u51fd\u6570\uff09\u3002\u8bbe\u7f6eFDR <0.05\u4e3a\u663e\u8457\u6027\u9608\u503c\u3002\u4fdd\u5b58\u7ed3\u679c\u4e3akegg_enrichment_*.csv\u3002\u4f7f\u7528ggplot2\u7ed8\u5236\u5bcc\u96c6\u6761\u5f62\u56fe\uff1aX\u8f74\u4e3a\u901a\u8def\u540d\u79f0\uff0cY\u8f74\u4e3a\u5bcc\u96c6\u4ee3\u8c22\u7269\u8ba1\u6570\uff0c\u989c\u8272\u6309KEGG\u5927\u5206\u7c7b\uff08kegg_class: Metabolism\u3001Genetic Information Processing\u3001Environmental Information Processing\u3001Cellular Processes\u3001Organismal Systems\uff09\u586b\u5145\uff0c\u70b9\u5927\u5c0f\u53cd\u6620\u5bcc\u96c6\u4ee3\u8c22\u7269\u6570\u3002\u540c\u65f6\u4fdd\u5b58PNG(300dpi)\u548cPDF\u4e24\u79cd\u683c\u5f0f\u3002\",\n \"goal\": \"\u8bc6\u522b\u6bcf\u7ec4\u6bd4\u5bf9\u4e2d\u663e\u8457\u5bcc\u96c6\u7684KEGG\u901a\u8def\uff0c\u63ed\u793a\u9ad8\u94c1\u996e\u98df\u8c03\u8282CDI\u6d89\u53ca\u7684\u6838\u5fc3\u4ee3\u8c22\u901a\u8def\uff08\u5982\u80c6\u6c41\u9178\u4ee3\u8c22\u3001\u94c1\u7a33\u6001\u3001\u8102\u80aa\u9178\u4ee3\u8c22\u3001\u6c28\u57fa\u9178\u4ee3\u8c22\u7b49\uff09\uff0c\u6309\u901a\u8def\u5927\u5206\u7c7b\u7ec4\u7ec7\u53ef\u89c6\u5316\"\n },\n {\n \"action\": \"\u6b65\u9aa43\u2014\u2014GSVA\u5206\u6790\u4e0e\u5dee\u5f02\u5206\u6790\u53ca\u53ef\u89c6\u5316\uff1a\u4ee5KEGG\u901a\u8def\u4e3a\u57fa\u56e0\u96c6\uff0c\u5bf9\u6574\u4e2a\u8868\u8fbe\u77e9\u9635\uff08\u5168\u90e82059\u4e2a\u4ee3\u8c22\u7269x18\u4e2a\u6837\u672c\uff09\u6267\u884cGSVA\uff08\u8c03\u7528enrichment.R\u4e2d\u7684perform_gsva\u51fd\u6570\uff0cmethod='gsva'\uff09\uff0c\u5f97\u5230\u901a\u8def\u6d3b\u6027\u8bc4\u5206\u77e9\u9635\uff08gsva_scores.csv\uff09\u3002\u4f7f\u7528limma\u5bf9GSVA\u8bc4\u5206\u77e9\u9635\u6267\u884c\u5dee\u5f02\u5206\u6790\uff08\u4e09\u7ec4\u6bd4\u5bf9\u8bbe\u8ba1\u540c\u6a21\u57574\uff09\uff0c\u8bc6\u522b\u663e\u8457\u5dee\u5f02\u6d3b\u6027\u7684\u901a\u8def\uff08gsva_differential_*.csv\uff09\u3002\u7ed8\u5236\u4ee5\u4e0b\u56fe\u5f62\uff1a(1)GSVA\u70ed\u56fe\uff08ComplexHeatmap\uff09\uff1a\u5217=\u6837\u672c\u6309\u5206\u7ec4\u6392\u5e8f\uff0c\u884c=\u901a\u8def\u6309\u5927\u5206\u7c7b\u5206\u7ec4+\u5c42\u6b21\u805a\u7c7b+\u805a\u7c7b\u6811\uff0c\u989c\u8272\u6761\u663e\u793a\u901a\u8def\u6d3b\u6027\uff1b(2)GSVA\u706b\u5c71\u56fe\uff08\u4e09\u7ec4\u6bd4\u5bf9\u5404\u4e00\u5f20\uff09\uff1a\u5c55\u793a\u663e\u8457\u4e0a\u8c03\u548c\u4e0b\u8c03\u7684\u901a\u8def\uff1b(3)GSVA\u7bb1\u7ebf\u56fe/\u5f97\u5206\u56fe\uff1a\u5c55\u793a\u5dee\u5f02\u663e\u8457\u901a\u8def\u7684\u6d3b\u6027\u8bc4\u5206\u5728\u4e09\u7ec4\u95f4\u7684\u5206\u5e03\u3002\u6240\u6709\u56fe\u5f62\u540c\u65f6\u4fdd\u5b58PNG(300dpi)\u548cPDF\u3002\",\n \"goal\": \"\u4ece\u901a\u8def\u6d3b\u6027\u5c42\u9762\u63ed\u793a\u9ad8\u94c1\u996e\u98df\u548cCDI\u611f\u67d3\u5bf9\u80a0\u9053\u4ee3\u8c22\u7f51\u7edc\u7684\u7cfb\u7edf\u6027\u5f71\u54cd\uff0c\u901a\u8fc7GSVA\u975e\u53c2\u6570\u6253\u5206\u65b9\u6cd5\u5f25\u8865\u5bcc\u96c6\u5206\u6790\u4ec5\u4f9d\u8d56\u5dee\u5f02\u4ee3\u8c22\u7269\u8ba1\u6570\u7684\u5c40\u9650\u6027\uff0c\u8bc6\u522b\u5728FE\u7ec4\u4e2d\u6574\u4f53\u4e0a\u8c03\u6216\u4e0b\u8c03\u7684\u4ee3\u8c22\u901a\u8def\u6a21\u5757\"\n }\n ],\n \"notes\": \"1.\u8fd9\u662f\u4ee3\u8c22\u7ec4\u5b66\u6570\u636e\uff0c\u4ee3\u8c22\u7269\u540d\u79f0\uff08Feature\u5217\uff09\u9700\u8981\u901a\u8fc7metabolites.csv\u6587\u4ef6\u4e2d\u7684'kegg'\u5217\uff08KEGG\u5316\u5408\u7269ID\uff0c\u5982C00047\uff09\u6620\u5c04\u5230KEGG\u901a\u8def\uff0c\u800c\u975e\u4f7f\u7528clusterProfiler\u7684\u57fa\u56e0ID\u6620\u5c04\u3002\\n2. data/\u76ee\u5f55\u4e0b\u65e0KEGG\u80cc\u666fXML/JSON\u6587\u4ef6\uff0cKEGG\u901a\u8def-\u5316\u5408\u7269\u6620\u5c04\u5173\u7cfb\u76f4\u63a5\u4ece\u4ee3\u8c22\u7269\u6ce8\u91ca\u8868metabolites.csv\u4e2d\u63d0\u53d6\uff08\u8be5\u8868\u5305\u542bkegg_class\u548ckegg_category\u5217\uff09\u3002\\n3.\u4ee3\u8c22\u7269\u540d\u79f0\u4e2d\u5b58\u5728\u7279\u6b8a\u5b57\u7b26\uff08HTML\u5b9e\u4f53\u5982&gamma;\u3001<i>\u6807\u7b7e\u7b49\uff09\uff0c\u6b65\u9aa41\u4e2d\u9700\u8981\u8fdb\u884c\u5b57\u7b26\u4e32\u6e05\u6d17\u3002\\n4. GSVA\u7684\u8f93\u5165\u9700\u8981\u4e00\u4e2a\u547d\u540d\u5217\u8868\uff08\u901a\u8def\u540d->\u4ee3\u8c22\u7269ID\u5411\u91cf\uff09\uff0c\u6b65\u9aa41\u9700\u6839\u636ekegg_category\u5217\u6784\u5efa\u6b64\u5217\u8868\u3002\\n5.\u5bf9\u4e8e\u6ca1\u6709KEGG\u6ce8\u91ca\u7684\u4ee3\u8c22\u7269\uff08kegg\u5217\u4e3a\u7a7a\u6216NA\uff09\uff0c\u5728\u6784\u5efa\u901a\u8def\u80cc\u666f\u548cGSVA\u57fa\u56e0\u96c6\u65f6\u4f1a\u88ab\u81ea\u52a8\u8fc7\u6ee4\u6389\uff0c\u9700\u8bb0\u5f55\u88ab\u8fc7\u6ee4\u7684\u6570\u91cf\u3002\\n6.\u5bcc\u96c6\u5206\u6790\u4f7f\u7528Fisher\u7cbe\u786e\u68c0\u9a8c\u800c\u975eclusterProfiler\u7684enrichKEGG\uff0c\u56e0\u4e3a\u4ee3\u8c22\u7269\u5bcc\u96c6\u9700\u8981\u4e0d\u540c\u7684\u5e95\u5c42KEGG\u6620\u5c04\u3002\\n7.\u811a\u672c\u5c06\u653e\u7f6e\u5728G:/OmicsWorks/test/metabolism/demo/tmp/5_kegg_functional_analysis/scripts/\u76ee\u5f55\u4e0b\u3002\"\n}\n```"}