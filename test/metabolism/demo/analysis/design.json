[{"name": "FE_vs_CD","treatment": "high iron diet before","control": "Clostridium difficile infection","biological_rationale": "\u3010\u6838\u5fc3\u6bd4\u5bf9\u3011FE\u7ec4\u4e0eCD\u7ec4\u5747\u611f\u67d3\u4e86\u8270\u96be\u68ad\u83cc\uff0c\u552f\u4e00\u533a\u522b\u5728\u4e8eFE\u7ec4\u5728\u611f\u67d3\u524d\u63a5\u53d7\u4e86\u9ad8\u94c1\u996e\u98df\uff08400 mg/kg\u786b\u9178\u4e9a\u94c1\uff09\u5e72\u9884\u3002\u6b64\u6bd4\u5bf9\u53ef\u76f4\u63a5\u63ed\u793a\u9ad8\u94c1\u996e\u98df\u5bf9CDI\u611f\u67d3\u72b6\u6001\u4e0b\u80a0\u9053\u4ee3\u8c22\u7ec4\u7684\u7279\u5f02\u6027\u8c03\u8282\u4f5c\u7528\u3002\u57fa\u4e8e\u77e5\u8bc6\u5e93\uff0c\u9ad8\u94c1\u996e\u98df\u901a\u8fc7\u589e\u52a0\u80a0\u9053\u5185\u94c1\u6d53\u5ea6\uff0c\u4fc3\u8fdbC.difficile\u751f\u957f\uff08FeoAB/Fhu/Fur\u7cfb\u7edf\uff09\u548c\u6bd2\u7d20\u4ea7\u751f\uff08tcdA/tcdB mRNA\u548c\u86cb\u767d\u4e0a\u8c03\uff09\uff0c\u540c\u65f6\u6539\u53d8\u5bbf\u4e3b\u8425\u517b\u514d\u75ab\uff08calprotectin\u91ca\u653e\u589e\u5f3a\u3001lipocalin-2\u4ecb\u5bfc\u7684\u94c1\u8f7d\u4f53\u87af\u5408\uff09\u548c\u80c6\u6c41\u9178\u4ee3\u8c22\u8c31\uff08\u7ed3\u5408\u578b\u80c6\u6c41\u9178\u5347\u9ad8\u4fc3\u8fdb\u5b62\u5b50\u840c\u53d1\uff09\u3002","expected_findings": "\u9884\u671fFE\u7ec4\u76f8\u5bf9\u4e8eCD\u7ec4\uff1a\u2460\u94c1\u7a33\u6001\u76f8\u5173\u4ee3\u8c22\u7269\uff08\u8840\u7ea2\u7d20\u3001\u94c1\u8f7d\u4f53\u5982enterobactin/aerobactin\u3001\u8f6c\u94c1\u86cb\u767d\uff09\u663e\u8457\u4e0a\u8c03\uff1b\u2461\u7ed3\u5408\u578b\u80c6\u6c41\u9178\uff08\u725b\u78fa\u80c6\u9178\u76d0TCA\u7b49\u4fc3\u5b62\u5b50\u840c\u53d1\u4ee3\u8c22\u7269\uff09\u5347\u9ad8\uff0c\u53bb\u7ed3\u5408\u578b\u80c6\u6c41\u9178\uff08\u80c6\u9178\u76d0CA\u7b49\u6291\u5236\u5b62\u5b50\u840c\u53d1\u4ee3\u8c22\u7269\uff09\u964d\u4f4e\uff1b\u2462\u77ed\u94fe\u8102\u80aa\u9178\uff08\u5c24\u5176\u662f\u4e01\u9178\uff09\u663e\u8457\u964d\u4f4e\uff0c\u53cd\u6620\u4ea7SCFA\u6709\u76ca\u83cc\uff08\u4e73\u9178\u6746\u83cc\u3001\u53cc\u6b67\u6746\u83cc\uff09\u51cf\u5c11\uff1b\u2463\u80a0\u6746\u83cc\u79d1\u76f8\u5173\u94c1\u8f7d\u4f53\u4ee3\u8c22\u7269\u5347\u9ad8\uff1b\u2464\u7cd6\u9175\u89e3/Stickland\u53d1\u9175\uff08\u812f\u6c28\u9178/\u7f9f\u812f\u6c28\u9178\u8fd8\u539f\uff09\u76f8\u5173\u4ee3\u8c22\u7269\u6bd4\u4f8b\u6539\u53d8\uff0c\u53cd\u6620C.difficile\u4ee3\u8c22\u9002\u5e94\uff1b\u2465\u560c\u5464/\u5627\u5576\u4ee3\u8c22\u7269\u53d8\u5316\u53cd\u6620\u7ec6\u83cc\u5feb\u901f\u589e\u6b96\uff1b\u2466\u6c27\u5316\u5e94\u6fc0\u76f8\u5173\u4ee3\u8c22\u7269\u5347\u9ad8\u53cd\u6620\u94c1\u6bd2\u6027\u3002"},{"name": "CD_vs_NC","treatment": "Clostridium difficile infection","control": "Standard (control)","biological_rationale": "\u3010\u6a21\u578b\u9a8c\u8bc1\u6bd4\u5bf9\u3011CD\u7ec4\u4e3a\u611f\u67d3C.difficile\u7684\u6807\u51c6\u9972\u6599\u5c0f\u9f20\uff0cNC\u7ec4\u4e3a\u672a\u63a5\u53d7\u4efb\u4f55\u5904\u7406\u7684\u5065\u5eb7\u5bf9\u7167\u5c0f\u9f20\u3002\u6b64\u6bd4\u5bf9\u7528\u4e8e\u5efa\u7acbCDI\u611f\u67d3\u672c\u8eab\u7684\u4ee3\u8c22\u7ec4\u7279\u5f81\u57fa\u7ebf\uff0c\u9a8c\u8bc1CDI\u5c0f\u9f20\u6a21\u578b\u662f\u5426\u6210\u529f\u5efa\u7acb\u3002\u6839\u636e\u77e5\u8bc6\u5e93\uff0cCDI\u611f\u67d3\u4f1a\u5f15\u53d1\u80a0\u9053\u83cc\u7fa4\u5931\u8c03\uff08\u80a0\u6746\u83cc\u79d1\u5bcc\u96c6\u3001\u4ea7SCFA\u83cc\u51cf\u5c11\uff09\u3001\u80c6\u6c41\u9178\u4ee3\u8c22\u7d0a\u4e71\uff08\u7ed3\u5408\u578b\u80c6\u6c41\u9178\u5347\u9ad8\u3001\u53bb\u7ed3\u5408\u578b\u80c6\u6c41\u9178\u964d\u4f4e\u4fc3\u8fdb\u5b62\u5b50\u840c\u53d1\u548c\u6bd2\u7d20\u4ea7\u751f\uff09\u3001\u5bbf\u4e3b\u8425\u517b\u514d\u75ab\u5e94\u7b54\uff08calprotectin\u548clipocalin-2\u4e0a\u8c03\uff09\u53ca\u708e\u75c7\u53cd\u5e94\uff08\u4e2d\u6027\u7c92\u7ec6\u80de\u6d78\u6da6\u3001TNF\u03b1/IL-1\u03b2\u7b49\u4fc3\u708e\u56e0\u5b50\u91ca\u653e\uff09\uff0c\u8fd9\u4e9b\u75c5\u7406\u8fc7\u7a0b\u5747\u4f1a\u5728\u4ee3\u8c22\u7ec4\u5c42\u9762\u53cd\u6620\u4e3a\u7279\u5b9a\u7684\u4ee3\u8c22\u7269\u8c31\u53d8\u5316\u3002","expected_findings": "\u9884\u671fCD\u7ec4\u76f8\u5bf9\u4e8eNC\u7ec4\uff1a\u2460\u80c6\u6c41\u9178\u8c31\u53d1\u751f\u5178\u578b\u504f\u79fb\u2014\u2014\u7ed3\u5408\u578b\u80c6\u6c41\u9178\uff08\u725b\u78fa\u80c6\u9178\u76d0TCA\u3001\u7518\u6c28\u80c6\u9178\u76d0GCA\uff09\u5347\u9ad8\uff0c\u53bb\u7ed3\u5408\u578b\u80c6\u6c41\u9178\uff08\u80c6\u9178\u76d0CA\u3001\u8131\u6c27\u80c6\u9178\u76d0DCA\uff09\u964d\u4f4e\uff1b\u2461\u77ed\u94fe\u8102\u80aa\u9178\uff08\u4e59\u9178\u3001\u4e19\u9178\u3001\u4e01\u9178\uff09\u6c34\u5e73\u4e0b\u964d\uff0c\u53cd\u6620\u83cc\u7fa4\u5931\u8c03\uff1b\u2462\u708e\u75c7\u76f8\u5173\u4ee3\u8c22\u7269\uff08\u524d\u5217\u817a\u7d20\u7c7b\u3001ROS\u76f8\u5173\u4ee3\u8c22\u7269\u3001\u8102\u8d28\u8fc7\u6c27\u5316\u7269\uff09\u5347\u9ad8\uff1b\u2463\u5bbf\u4e3b\u8425\u517b\u514d\u75ab\u76f8\u5173\u4ee3\u8c22\u7269\uff08calprotectin\u87af\u5408\u7684\u91d1\u5c5e\u590d\u5408\u7269\u3001lipocalin-2\u7ed3\u5408\u7684\u513f\u8336\u915a\u7c7b\u94c1\u8f7d\u4f53\uff09\u589e\u52a0\uff1b\u2464\u80a0\u4e0a\u76ae\u635f\u4f24\u6807\u5fd7\u7269\uff08\u5982I-FABP\u76f8\u5173\u4ee3\u8c22\u7269\uff09\u53ef\u80fd\u5347\u9ad8\uff1b\u2465\u7cd6\u4ee3\u8c22\u548c\u6c28\u57fa\u9178\u4ee3\u8c22\u8c31\u6539\u53d8\u53cd\u6620\u5bbf\u4e3b-\u75c5\u539f\u83cc\u4ee3\u8c22\u7ade\u4e89\u3002"},{"name": "FE_vs_NC","treatment": "high iron diet before","control": "Standard (control)","biological_rationale": "\u3010\u6574\u4f53\u6548\u5e94\u6bd4\u5bf9\u3011FE\u7ec4\u540c\u65f6\u63a5\u53d7\u4e86\u9ad8\u94c1\u996e\u98df\u5e72\u9884\u548cCDI\u611f\u67d3\uff0cNC\u7ec4\u4e3a\u5065\u5eb7\u5bf9\u7167\u3002\u6b64\u6bd4\u5bf9\u7528\u4e8e\u8bc4\u4f30\u9ad8\u94c1\u996e\u98df\u5e72\u9884\u8054\u5408CDI\u611f\u67d3\u76f8\u5bf9\u4e8e\u5065\u5eb7\u57fa\u7ebf\u7684\u6574\u4f53\u4ee3\u8c22\u6270\u52a8\u5e45\u5ea6\u548c\u65b9\u5411\u3002\u4e0eCD_vs_NC\u6bd4\u5bf9\u7684\u4ee3\u8c22\u53d8\u5316\u5e45\u5ea6\u8fdb\u884c\u6bd4\u8f83\u5206\u6790\uff0c\u53ef\u533a\u5206\u54ea\u4e9b\u4ee3\u8c22\u53d8\u5316\u662fCDI\u611f\u67d3\u672c\u8eab\u5f15\u8d77\u7684\uff0c\u54ea\u4e9b\u662f\u9ad8\u94c1\u996e\u98df\u4e0eCDI\u7684\u534f\u540c/\u53e0\u52a0\u6548\u5e94\u3002\u6839\u636e\u77e5\u8bc6\u5e93\uff0c\u9ad8\u94c1\u996e\u98df\u9884\u8ba1\u4f1a\u52a0\u5267CDI\u7684\u4ee3\u8c22\u7d0a\u4e71\uff0c\u5305\u62ec\u8fdb\u4e00\u6b65\u4fc3\u8fdb\u80a0\u6746\u83cc\u79d1\u7b49\u94c1\u8f7d\u4f53\u4ea7\u751f\u83cc\u5bcc\u96c6\u3001\u6291\u5236\u4e73\u9178\u6746\u83cc/\u53cc\u6b67\u6746\u83cc\u7b49\u6709\u76ca\u83cc\u3001\u6539\u53d8\u5bbf\u4e3b\u94c1\u4ee3\u8c22\u548c\u80c6\u6c41\u9178\u4ee3\u8c22\u3002","expected_findings": "\u9884\u671fFE\u7ec4\u76f8\u5bf9\u4e8eNC\u7ec4\uff1a\u2460\u6574\u4f53\u4ee3\u8c22\u6270\u52a8\u5e45\u5ea6\u5927\u4e8eCD_vs_NC\uff0c\u53cd\u6620\u9ad8\u94c1\u996e\u98df\u7684\u53e0\u52a0/\u534f\u540c\u6548\u5e94\uff1b\u2461\u94c1\u76f8\u5173\u4ee3\u8c22\u7269\uff08\u8840\u7ea2\u7d20\u3001\u94c1\u86cb\u767d\u76f8\u5173\u4ee3\u8c22\u7269\u3001\u94c1\u8f7d\u4f53\uff09\u53d8\u5316\u5e45\u5ea6\u663e\u8457\u5927\u4e8eCD\u7ec4\uff1b\u2462\u80c6\u6c41\u9178\u4ee3\u8c22\u7d0a\u4e71\u7a0b\u5ea6\u52a0\u5267\uff0c\u4fc3\u5b62\u5b50\u840c\u53d1\u7684\u725b\u78fa\u80c6\u9178\u76d0\u8fdb\u4e00\u6b65\u5347\u9ad8\uff0c\u6291\u5236\u5b62\u5b50\u840c\u53d1\u7684\u80c6\u9178\u76d0\u8fdb\u4e00\u6b65\u964d\u4f4e\uff1b\u2463SCFA\u6c34\u5e73\u964d\u4f4e\u5e45\u5ea6\u5927\u4e8eCD\u7ec4\uff0c\u53cd\u6620\u9ad8\u94c1\u996e\u98df\u5bf9\u6709\u76ca\u83cc\u7fa4\u7684\u989d\u5916\u6291\u5236\u6548\u5e94\uff1b\u2464\u80a0\u6746\u83cc\u79d1\u76f8\u5173\u7684\u8150\u8d25\u4ee3\u8c22\u4ea7\u7269\uff08\u5982\u916a\u80fa\u3001\u5c38\u80fa\u3001\u915a\u7c7b\u3001\u5432\u54da\u7c7b\uff09\u5347\u9ad8\u66f4\u663e\u8457\uff1b\u2465\u53ef\u80fd\u89c2\u5bdf\u5230\u4e0e\u94c1\u6bd2\u6027\u76f8\u5173\u7684\u6c27\u5316\u5e94\u6fc0\u4ee3\u8c22\u7269\uff08\u8c37\u80f1\u7518\u80bd\u4ee3\u8c22\u7269\u3001\u8102\u8d28\u8fc7\u6c27\u5316\u7269\uff09\u663e\u8457\u5347\u9ad8\u3002"}]