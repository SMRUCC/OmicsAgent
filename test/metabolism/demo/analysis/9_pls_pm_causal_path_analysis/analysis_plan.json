8f7d\u548c\u4e24\u7c7b\u6f5c\u53d8\u91cf\u4f53\u7cfb\u7684\u6784\u5efa\uff0c\u8bc4\u4f30\u5185\u90e8\u4e00\u81f4\u6027\u4fe1\u5ea6\u3002\u4f53\u7cfbA\u786e\u4fdd\u4e0eWGCNA/BN\u7ed3\u679c\u7684\u53ef\u6bd4\u6027\uff1b\u4f53\u7cfbB\u4eceKEGG\u529f\u80fd\u5c42\u9762\u63d0\u4f9b\u4e92\u8865\u89c6\u89d2\u3002\"\n },\n {\n \"action\": \"[\u8def\u5f84\u6a21\u578b\u5b9a\u4e49\u4e0ePLS-PM\u5efa\u6a21]\u5b9a\u4e49\u4e24\u4e2a\u4e92\u8865\u8def\u5f84\u6a21\u578b\uff1a\\n\\n\u6a21\u578bA\u2014\u6a21\u5757\u7ea7\u56e0\u679c\u8def\u5f84(\u57fa\u4e8eBN\u8bc6\u522b\u76846\u6761\u8c03\u63a7\u8f74)\uff1a\\n\u5916\u751fLV: BlackModule(\u57fa\u7840\u4ee3\u8c22)\u2192TurquoiseModule(\u9ad8\u94c1\u996e\u98df)\\n\u5185\u751f\u94fe: TurquoiseModule \u2192 RedModule(\u514d\u75ab\u6291\u5236) + BlueModule(\u5065\u5eb7\u6291\u5236)\\n MagentaModule(CDI)\u2192 RedModule(\u514d\u75ab\u6fc0\u6d3b) + BlueModule(\u5065\u5eb7\u6291\u5236)\\n BlueModule \u2192 RedModule(\u5065\u5eb7\u652f\u6301)\\n (\u8def\u5f84\u77e9\u9635\u57fa\u4e8eBN\u7f6e\u4fe1\u5ea6\u22650.7\u7684\u6709\u5411\u8fb9\u8bbe\u5b9a)\\n\\n\u6a21\u578bB\u2014\u901a\u8def\u7ea7\u56e0\u679c\u8def\u5f84(\u57fa\u4e8e'\u996e\u98df-\u83cc\u7fa4-\u5bbf\u4e3b'\u5047\u8bf4)\uff1a\\n\u5916\u751f: Iron_Metabolism\\n\u4e2d\u4ecb: Lipid_Metabolism \u2192 Signal_Transduction\\n Energy_Metabolism \u2192 Excretory_System\\n\u5185\u751f: Signal_Transduction(\u5bbf\u4e3b\u514d\u75ab\u7ed3\u5c40)\\n\u8def\u5f84: Iron\u2192Lipid\u2192Signal; Iron\u2192Energy\u2192Excretory; Iron\u2192Signal\u76f4\u63a5\u8def\u5f84\\n\\n\u5bf9\u4e24\u4e2a\u6a21\u578b\u5206\u522b\u8fd0\u884cplspm()\uff1a\u6a21\u5f0fA(\u53cd\u6620\u578b)\u3001scaled=TRUE\u3001bootstrap=1000\u6b21\u3002\u63d0\u53d6\u8def\u5f84\u7cfb\u6570\u3001\u8f7d\u8377\u3001\u6f5c\u53d8\u91cf\u5f97\u5206\u3001\u603b\u6548\u5e94\u3001GoF\u3002\",\n \"goal\": \"\u5b8c\u6210\u4e24\u4e2a\u6a21\u578b\u7684PLS-PM\u62df\u5408\u3002\u6a21\u578bA\u9a8c\u8bc1BN\u53d1\u73b0\u76846\u6761\u8c03\u63a7\u65b9\u5411\u662f\u5426\u5177\u6709\u56e0\u679c\u8def\u5f84\u652f\u6301\uff1b\u6a21\u578bB\u68c0\u9a8c'\u9ad8\u94c1\u996e\u98df\u2192\u83cc\u7fa4\u4ee3\u8c22\u2192\u5bbf\u4e3b\u514d\u75ab'\u7684\u529f\u80fd\u56e0\u679c\u94fe\u3002bootstrap1000\u6b21\u786e\u4fdd\u5c0f\u6837\u672c\u7a33\u5065\u6027\u3002\"\n },\n {\n \"action\": \"[\u53ef\u89c6\u5316\u4e0e\u7ed3\u679c\u6c47\u603b]\u4f7f\u7528igraph+ggplot2\u7ed8\u5236\u51fa\u7248\u7ea7\u8def\u5f84\u56fe\uff1a\\n\\n(1) PLSPM_module_path_diagram\uff1a6\u4e2aLV\u6a21\u5757\u7ea7\u8def\u5f84\u56fe\\n -\u8282\u70b9\u989c\u8272\u6309\u5173\u8054\u5206\u7ec4\u6620\u5c04(FE\u7ea2/NC\u84dd/CD\u7eff)\uff0c\u5927\u5c0f\u6620\u5c04\u4ee3\u8c22\u7269\u6570\u91cf\\n -\u6709\u5411\u8fb9\uff1a\u7c97\u7ec6=\u8def\u5f84\u7cfb\u6570|\u7edd\u5bf9\u503c|\uff0c\u6b63=\u7ea2\u8272\u5b9e\u7ebf,\u8d1f=\u84dd\u8272\u865a\u7ebf\\n -\u8fb9\u6807\u7b7e\u6807\u6ce8\u8def\u5f84\u7cfb\u6570\u503c\u548cbootstrap\u663e\u8457\u6027(*p<0.05, **p<0.01, ***p<0.001)\\n -\u5e95\u90e8\u6dfb\u52a0GoF\u503c\u548c\u5404LV\u7684R\u00b2\\n\\n(2) PLSPM_pathway_path_diagram\uff1a5\u4e2aLV\u901a\u8def\u7ea7\u8def\u5f84\u56fe\\n -\u7c7b\u4f3c\u8bbe\u8ba1\uff0c\u91cd\u70b9\u6807\u6ce8\u5173\u952e\u56e0\u679c\u94fe\u7684\u8def\u5f84\u7cfb\u6570\\n\\n(3) PLSPM_bootstrap_stability\uff1abootstrap1000\u6b21\u8def\u5f84\u7cfb\u6570\u7684\u5206\u5e03\u76f4\u65b9\u56fe+\u7f6e\u4fe1\u533a\u95f4\\n\\n\u6240\u6709\u56fe\u5f62\uff1atheme_minimal+\u82f1\u6587\u6807\u7b7e\u3001\u540c\u65f6\u4fdd\u5b58PDF(\u77e2\u91cf)\u548cPNG(300dpi)\u300112\u00d710\u82f1\u5bf8\u3002\\n\u7ed3\u679c\u6c47\u603b\u81f3result.json\u3002\",\n \"goal\": \"\u4ee5\u51fa\u7248\u7ea7\u56fe\u5f62\u53ef\u89c6\u5316\u4e24\u7c7b\u8def\u5f84\u6a21\u578b\uff0c\u6e05\u6670\u5c55\u793a\u6a21\u5757\u95f4\u548c\u901a\u8def\u95f4\u7684\u56e0\u679c\u8def\u5f84\u7cfb\u6570\u4e0e\u663e\u8457\u6027\u3002bootstrap\u5206\u5e03\u56fe\u4e3a\u5c0f\u6837\u672c\u5206\u6790\u7ed3\u679c\u7684\u7a33\u5065\u6027\u63d0\u4f9b\u91cf\u5316\u8bc1\u636e\u3002\"\n }\n ],\n \"notes\": \"1.\u3010\u5355\u7ec4\u5b66\u8bf4\u660e\u3011\u672c\u6570\u636e\u96c6\u4e3a\u5355\u7ec4\u5b66(\u4ee3\u8c22\u7ec4\u5b66)\uff0c\u4f46WGCNA\u6a21\u5757\u7279\u5f81\u57fa\u56e0(MEs)\u805a\u5408\u4e86\u6570\u767e\u4e2a\u534f\u540c\u53d8\u5316\u7684\u4ee3\u8c22\u7269\uff0c\u6784\u6210\u4e0d\u540c'\u4ee3\u8c22\u7a0b\u5e8f'\u6f5c\u53d8\u91cf\uff0cKEGG GSVA\u5f97\u5206\u4ee3\u8868\u529f\u80fd\u5c42\u7ea7\uff0c\u5b9e\u73b0\u4e86\u4ece\u5355\u7ec4\u5b66\u5230\u591a\u5c42\u7ea7\u6f5c\u53d8\u91cf\u7684\u5347\u7ef4\u3002\\n2.\u3010\u6837\u672c\u91cf\u9650\u5236\u301118\u6837\u672c\u00d76LV(\u6a21\u578bA)\u62165LV(\u6a21\u578bB)\uff0c\u6837\u672c/LV\u22483\u3002PLS-PM\u5bf9\u6837\u672c\u91cf\u8981\u6c42\u4f4e\u4e8eCB-SEM\uff0c\u4f46\u4ecd\u5c5e\u5c0f\u6837\u672c\u3002\u7f13\u89e3\u7b56\u7565\uff1a\u53cd\u6620\u578b\u6a21\u5f0fA\u964d\u4f4e\u53c2\u6570\u4f30\u8ba1\u91cf\u3001bootstrap1000\u6b21\u8bc4\u4f30\u7a33\u5b9a\u6027\u3001\u805a\u7126\u6548\u5e94\u91cf\u5927\u4e14\u7f6e\u4fe1\u533a\u95f4\u4e0d\u5305\u542b0\u7684\u8def\u5f84\u3002\\n3.\u3010\u8def\u5f84\u65b9\u5411\u4f9d\u636e\u3011\u6a21\u578bA\u8def\u5f84\u5b8c\u5168\u7ee7\u627f\u6a21\u57578(BN)\u76846\u6761\u9ad8\u7f6e\u4fe1\u5ea6\u6709\u5411\u8fb9\uff1aTurquoise\u2192Blue(0.985)\u3001Turquoise\u2192Red(0.870)\u3001Magenta\u2192Blue(0.725)\u3001Magenta\u2192Red(0.780)\u3001Blue\u2192Red(0.735)\u3001Black\u2192Purple(0.795)\uff0c\u5c5e\u4e8e\u9a8c\u8bc1\u6027\u5206\u6790\u3002\\n4.\u3010\u6a21\u578b\u6bd4\u8f83\u3011\u82e5\u6a21\u578bA GoF\u66f4\u9ad8\uff0c\u8bf4\u660e\u6a21\u5757\u7ea7\u805a\u5408\u66f4\u80fd\u6355\u83b7\u56e0\u679c\u7ed3\u6784\uff1b\u82e5\u6a21\u578bB GoF\u66f4\u9ad8\uff0c\u8bf4\u660eKEGG\u901a\u8def\u5206\u7ec4\u66f4\u5177\u89e3\u91ca\u529b\u3002\u4e24\u6a21\u578b\u4e92\u4e3a\u9a8c\u8bc1\u3002\\n5.\u3010\u5305\u4f9d\u8d56\u3011\u9700plspm\u3001igraph\u3001ggplot2\u3001ggrepel\u3001psych\u7b49\uff0c\u811a\u672c\u5f00\u5934\u81ea\u52a8\u5b89\u88c5\u7f3a\u5931\u5305\u3002\"\n}\n```\n\n---\n\n###\u5206\u6790\u8ba1\u5212\u8981\u70b9\u89e3\u8bfb#### \ud83c\udfaf\u6838\u5fc3\u79d1\u5b66\u95ee\u9898\u5728 **\"\u9ad8\u94c1\u996e\u98df \u2192\u80a0\u9053\u83cc\u7fa4\u5931\u8c03 \u2192 CDI\u6613\u611f\u6027\u6539\u53d8 \u2192\u4ee3\u8c22\u7269\u4ecb\u5bfc\"**\u7684\u7814\u7a76\u94fe\u6761\u4e2d\uff0cPLS-PM\u65e8\u5728\u56de\u7b54\u4ee5\u4e0b **\u56e0\u679c\u5173\u7cfb**\u95ee\u9898\uff1a\n-\u9ad8\u94c1\u996e\u98df\u8bf1\u5bfc\u7684\u4ee3\u8c22\u6a21\u5757\uff08Turquoise\u6a21\u5757\uff09**\u662f\u5426\u4ee5\u53ca\u5982\u4f55**\u6291\u5236\u5bbf\u4e3b\u514d\u75ab\u4fe1\u53f7\uff08Red\u6a21\u5757/\u4fe1\u53f7\u8f6c\u5bfc\u901a\u8def\uff09\uff1f\n- CDI\u611f\u67d3\u7279\u5f81\u6a21\u5757\uff08Magenta\uff09**\u662f\u5426\u6fc0\u6d3b**\u514d\u75ab\u4fe1\u53f7\uff1f\n-\u5065\u5eb7\u57fa\u7ebf\u4ee3\u8c22\u72b6\u6001\uff08Blue\u6a21\u5757\uff09**\u662f\u5426\u652f\u6301**\u514d\u75ab\u529f\u80fd\uff1f\n\n#### \ud83c\udfd7\ufe0f\u53cc\u6a21\u578b\u4e92\u8865\u8bbe\u8ba1|\u7ef4\u5ea6 |\u6a21\u578bA \u2014\u6a21\u5757\u7ea7 |\u6a21\u578bB \u2014\u901a\u8def\u7ea7 |\n|:---|:---|:---|\n| **\u6f5c\u53d8\u91cf** |6\u4e2aWGCNA MEs |5\u4e2aKEGG\u901a\u8def\u805a\u5408 |\n| **\u8def\u5f84\u6765\u6e90** | BN\u6709\u5411\u8fb9(\u7f6e\u4fe1\u5ea6\u22650.7) |\u7814\u7a76\u5047\u8bf4(\u996e\u98df\u2192\u83cc\u7fa4\u2192\u5bbf\u4e3b) |\n| **\u6838\u5fc3\u8def\u5f84** | Turquoise\u2192Red(\u514d\u75ab\u6291\u5236) | Iron\u2192Lipid\u2192Signal |\n| **\u9a8c\u8bc1\u76ee\u6807** |\u6a21\u5757\u95f4\u8c03\u63a7\u65b9\u5411 |\u529f\u80fd\u5c42\u7ea7\u56e0\u679c\u94fe |\n\n#### \ud83d\udd04\u4e0a\u6e38\u8854\u63a5- **\u6a21\u57576(WGCNA)**\uff1a\u76f4\u63a5\u4f7f\u7528\u51766\u4e2aMEs\u4f5c\u4e3a\u6a21\u578bA\u7684\u6f5c\u53d8\u91cf- **\u6a21\u57575(KEGG GSVA)**\uff1a22\u4e2a\u901a\u8def\u6d3b\u6027\u5f97\u5206\u805a\u5408\u4e3a\u6a21\u578bB\u76845\u4e2aLV- **\u6a21\u57578(BN)**\uff1a\u6a21\u578bA\u7684\u8def\u5f84\u7ed3\u6784\u5b8c\u5168\u7ee7\u627fBN\u76846\u6761\u9ad8\u7f6e\u4fe1\u5ea6\u6709\u5411\u8fb9- **\u6a21\u57577(CMeans)**\uff1a\u8282\u70b9\u6ce8\u91ca\u4e2d\u6807\u6ce8\u5bf9\u5e94\u7684CMeans\u7c07\u7f16\u53f7(\u5982Turquoise\u5bf9\u5e94Cluster1)"}