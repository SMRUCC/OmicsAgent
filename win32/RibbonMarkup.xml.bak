<?xml version="1.0" encoding="utf-8"?>
<Application xmlns="http://schemas.microsoft.com/windows/2009/Ribbon">
  <Application.Commands>
    <Command Name="cmdButtonOpenKb" Id="2" LabelTitle="Open Research KB" />
    <Command Name="cmdMenuResearchWork" Id="3" LabelTitle="Research" />
    <Command Name="cmdGroupResearchWork" Id="4" LabelTitle="Research" />
    <Command Name="cmdTabResearchWork" Id="5" LabelTitle="Research" />
    <Command Name="cmdButtonOpenResearch" Id="6" LabelTitle="Start" />
    <Command Name="cmdGroupMain" Id="7" />
    <Command Name="cmdPanelMain" Id="8" />
    <Command Name="cmdTabMain" Id="9" />
    <Command Name="cmdBtnOpenKBLib" Id="10" LabelTitle="View KB" />
    <Command Name="cmdTabKBLib" Id="11" />
    <Command Name="cmdMenuKBLib" Id="12" />
    <Command Name="cmdGroupKBLib" Id="13" />
  </Application.Commands>
  <Application.Views>
    <Ribbon>
      <Ribbon.ApplicationMenu>
        <ApplicationMenu />
      </Ribbon.ApplicationMenu>
      <Ribbon.QuickAccessToolbar>
        <QuickAccessToolbar />
      </Ribbon.QuickAccessToolbar>
      <Ribbon.ContextualTabs>
        <TabGroup CommandName="cmdMenuResearchWork">
