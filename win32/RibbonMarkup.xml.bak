<?xml version="1.0" encoding="utf-8"?>
<Application xmlns="http://schemas.microsoft.com/windows/2009/Ribbon">
  <Application.Commands>
    <Command Name="cmdButtonLLMTool" Id="25" LabelTitle="LLM">
      <Command.SmallImages>
        <Image MinDPI="192">Icons/icons8-analyzing-skill-96.png</Image>
      </Command.SmallImages>
      <Command.LargeImages>
        <Image MinDPI="192">Icons/icons8-analyzing-skill-96.png</Image>
      </Command.LargeImages>
    </Command>
    <Command Name="cmdBtnOpenKBLib" Id="10" LabelTitle="View KB">
      <Command.SmallImages>
        <Image MinDPI="192">Icons/icons8-library-96.png</Image>
      </Command.SmallImages>
      <Command.LargeImages>
        <Image MinDPI="192">Icons/icons8-library-96.png</Image>
      </Command.LargeImages>
    </Command>
    <Command Name="cmdButtonExit" Id="17" LabelTitle="Exit">
      <Command.SmallImages>
        <Image MinDPI="192">Icons/icons8-exit-96.png</Image>
      </Command.SmallImages>
      <Command.LargeImages>
        <Image MinDPI="192">Icons/icons8-exit-96.png</Image>
      </Command.LargeImages>
    </Command>
    <Command Name="cmdButtonLicense" Id="18" LabelTitle="License">
      <Command.SmallImages>
        <Image MinDPI="192">Icons/icons8-information-96.png</Image>
      </Command.SmallImages>
      <Command.LargeImages>
        <Image MinDPI="192">Icons/icons8-information-96.png</Image>
      </Command.LargeImages>
    </Command>
    <Command Name="cmdButtonOpenConsole" Id="22" LabelTitle="Console">
      <Command.SmallImages>
        <Image MinDPI="192">Icons/icons8-bash-96.png</Image>
      </Command.SmallImages>
      <Command.LargeImages>
        <Image MinDPI="192">Icons/icons8-bash-96.png</Image>
      </Command.LargeImages>
    </Command>
    <Command Name="cmdButtonOpenFolder" Id="16" LabelTitle="Open Folder">
      <Command.SmallImages>
        <Image MinDPI="192">Icons/icons8-file-explorer-new-96.png</Image>
      </Command.SmallImages>
      <Command.LargeImages>
        <Image MinDPI="192">Icons/icons8-file-explorer-new-96.png</Image>
      </Command.LargeImages>
    </Command>
    <Command Name="cmdButtonOpenKb" Id="2" LabelTitle="Open Research KB">
      <Command.SmallImages>
        <Image MinDPI="192">Icons/icons8-books-96.png</Image>
      </Command.SmallImages>
      <Command.LargeImages>
        <Image MinDPI="192">Icons/icons8-books-96.png</Image>
      </Command.LargeImages>
    </Command>
    <Command Name="cmdButtonOpenResearch" Id="6" LabelTitle="Start">
      <Command.SmallImages>
        <Image MinDPI="192">Icons/icons8-research-96.png</Image>
      </Command.SmallImages>
      <Command.LargeImages>
        <Image MinDPI="192">Icons/icons8-research-96.png</Image>
      </Command.LargeImages>
    </Command>
    <Command Name="cmdButtonToggleTheme" Id="15" LabelTitle="Light/Dark Theme">
      <Command.SmallImages>
        <Image MinDPI="192">Icons/icons8-theme-96.png</Image>
      </Command.SmallImages>
      <Command.LargeImages>
        <Image MinDPI="192">Icons/icons8-theme-96.png</Image>
      </Command.LargeImages>
    </Command>
    <Command Name="cmdButtonVennTool" Id="23" LabelTitle="jVenn Tool">
      <Command.SmallImages>
        <Image MinDPI="192">Icons/icons8-venn-diagram-100.png</Image>
      </Command.SmallImages>
      <Command.LargeImages>
        <Image MinDPI="192">Icons/icons8-venn-diagram-100.png</Image>
      </Command.LargeImages>
    </Command>
    <Command Name="cmdGroupInformation" Id="20" LabelTitle="Information" />
    <Command Name="cmdGroupKBLib" Id="13" LabelTitle="Knowledge Base" />
    <Command Name="cmdGroupMain" Id="7" LabelTitle="Omics Research" />
    <Command Name="cmdGroupResearchWork" Id="4" LabelTitle="Research" />
    <Command Name="cmdGroupTools" Id="14" LabelTitle="Tools" />
    <Command Name="cmdGroupWorkTools" Id="21" LabelTitle="Tools" />
    <Command Name="cmdMenuKBLib" Id="12" LabelTitle="Knowledge Base" />
    <Command Name="cmdMenuResearchWork" Id="3" LabelTitle="Research" />
    <Command Name="cmdMenuTools" Id="24" LabelTitle="Tools" />
    <Command Name="cmdPanelMain" Id="8" LabelTitle="Omics Research" />
    <Command Name="cmdTabInformation" Id="19" LabelTitle="Information" />
    <Command Name="cmdTabKBLib" Id="11" LabelTitle="Knowledge Base" />
    <Command Name="cmdTabMain" Id="9" LabelTitle="Omics Research" />
    <Command Name="cmdTabResearchWork" Id="5" LabelTitle="Research" />
  </Application.Commands>
  <Application.Views>
    <Ribbon>
      <Ribbon.ApplicationMenu>
        <ApplicationMenu>
          <MenuGroup>
            <Button CommandName="cmdButtonOpenFolder" />
            <Button CommandName="cmdButtonOpenResearch" />
          </MenuGroup>
          <MenuGroup Class="StandardItems">
            <DropDownButton CommandName="cmdMenuTools">
              <Button CommandName="cmdButtonOpenConsole" />
              <Button CommandName="cmdButtonVennTool" />
              <Button CommandName="cmdButtonLLMTool" />
            </DropDownButton>
          </MenuGroup>
          <MenuGroup>
            <Button CommandName="cmdButtonLicense" />
          </MenuGroup>
          <MenuGroup>
            <Button CommandName="cmdButtonExit" />
          </MenuGroup>
        </ApplicationMenu>
      </Ribbon.ApplicationMenu>
      <Ribbon.QuickAccessToolbar>
        <QuickAccessToolbar />
      </Ribbon.QuickAccessToolbar>
      <Ribbon.ContextualTabs>
        <TabGroup CommandName="cmdMenuResearchWork">
          <Tab CommandName="cmdTabResearchWork">
            <Group CommandName="cmdGroupResearchWork" SizeDefinition="OneButton">
              <Button CommandName="cmdButtonOpenKb" />
            </Group>
          </Tab>
        </TabGroup>
        <TabGroup CommandName="cmdMenuKBLib">
          <Tab CommandName="cmdTabKBLib">
            <Group CommandName="cmdGroupKBLib" SizeDefinition="OneButton">
              <Button CommandName="cmdBtnOpenKBLib" />
            </Group>
            <Group CommandName="cmdGroupTools" SizeDefinition="OneButton">
              <Button CommandName="cmdButtonToggleTheme" />
            </Group>
          </Tab>
        </TabGroup>
      </Ribbon.ContextualTabs>
      <Ribbon.Tabs>
        <Tab CommandName="cmdTabMain">
          <Group CommandName="cmdGroupMain" SizeDefinition="TwoButtons">
            <Button CommandName="cmdButtonOpenFolder" />
            <Button CommandName="cmdButtonOpenResearch" />
          </Group>
          <Group CommandName="cmdGroupWorkTools" SizeDefinition="TwoButtons">
            <Button CommandName="cmdButtonOpenConsole" />
            <Button CommandName="cmdButtonVennTool" />
          </Group>
        </Tab>
        <Tab CommandName="cmdTabInformation">
          <Group CommandName="cmdGroupInformation" SizeDefinition="OneButton">
            <Button CommandName="cmdButtonLicense" />
          </Group>
        </Tab>
      </Ribbon.Tabs>
    </Ribbon>
    <ContextPopup />
  </Application.Views>
</Application>
<!--ResourceName Value="APPLICATION"-->